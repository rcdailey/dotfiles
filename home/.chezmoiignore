# Machine-specific files that should not be tracked by chezmoi
.gitkeep
.gitconfig.local

# Python build artifacts (in case any managed source ever contains them)
**/__pycache__/**
**/.venv/**
**/*.pyc

# Colocated OpenCode directory plugin tests
**/*.test.ts

# Run the appropriate scripts based on OS
{{ if eq .chezmoi.os "windows" }}
.chezmoiscripts/*.sh
{{ end }}

# Exclude these files if we're not on MacOS
{{ if ne .chezmoi.os "darwin" }}
.config/iterm2/**
.config/karabiner/**
Library/**
{{ end }}

# rbw reads from ~/Library/Application Support/ on macOS, not XDG
{{ if eq .chezmoi.os "darwin" }}
.config/rbw/**
{{ end }}

{{ if ne .chezmoi.os "windows" }}
Documents/**
{{ end }}

# Exclude AppData directory on non-Windows platforms
{{ if ne .chezmoi.os "windows" }}
AppData/**
{{ end }}

# Exclude Linux-specific files on non-Linux platforms
{{ if ne .chezmoi.os "linux" }}
.chezmoiscripts/run_once_after_reload-systemd-opencode-v2.sh
.chezmoiscripts/run_once_after_migrate-ai-usagebar.sh
.chezmoiscripts/run_once_before_stop-opencode-v1-cleanup.sh
.config/kwinrc
.config/systemd/**
.config/topgrade.d/codexbar.toml
.local/bin/update-codexbar-plasmoid
{{ end }}
