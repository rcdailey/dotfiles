#!/usr/bin/env bash
# Link local herdr plugins. Runs when this script or any managed herdr config file changes.
# Rerun once herdr appears on PATH; a run before mise installs it exits early and records success.
# herdr {{ lookPath "herdr" }}
{{ range glob (joinPath .chezmoi.sourceDir "dot_config/herdr/**") -}}
{{   if not (stat .).isDir -}}
# {{ include . | sha256sum }} {{ . }}
{{   end -}}
{{ end -}}

command -v herdr >/dev/null || exit 0
herdr plugin link {{ joinPath .chezmoi.homeDir ".config/herdr/lazygit-follow" | quote }} >/dev/null
