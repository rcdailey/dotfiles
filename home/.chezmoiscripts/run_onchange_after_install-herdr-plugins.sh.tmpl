{{ range glob (joinPath .chezmoi.sourceDir "dot_config/herdr/**") -}}
{{   if not (stat .).isDir -}}
# {{ include . | sha256sum }} {{ . }}
{{   end -}}
{{ end -}}

command -v herdr >/dev/null || exit 0
herdr plugin install devashish2203/herdr-worktrunk --yes
