#!/bin/sh
# Global pre-commit hook: runs the pre-commit framework in every repository that configures it.
# Git also runs the repository hook directory, so a `pre-commit install` shim there would run
# the same checks twice; defer to it when present.

# Ensure mise shims are in PATH for correct tool versions
export PATH="$HOME/.local/share/mise/shims:$PATH"

# Per-repo opt-out
if [ -f .no-global-hooks ]; then
    exit 0
fi

repo_hook=$(git rev-parse --git-path hooks/pre-commit)
hooks_path=$(git config --get core.hooksPath) && repo_hook="$hooks_path/pre-commit"
if [ -f "$repo_hook" ] && grep -q "File generated by pre-commit" "$repo_hook"; then
    exit 0
fi

if [ -f .pre-commit-config.yaml ] && command -v pre-commit >/dev/null 2>&1; then
    exec pre-commit run --hook-stage pre-commit
fi
