# Kitty Terminal Configuration

# Use herdr as the shell - kitty closes when herdr exits. Refresh herdr's
# OpenCode integration first so it tracks the installed herdr version.
shell zsh -lc '[[ $(herdr integration status) == *"opencode: current"* ]]
\ || herdr integration install opencode &>/dev/null; exec herdr'

# Remote control for scripting (reload-all alias)
allow_remote_control yes
listen_on unix:/tmp/kitty-{kitty_pid}

# macOS: treat Option as Alt for keybindings (ignored on Linux)
macos_option_as_alt yes

# Font settings
font_family postscript_name=FiraCode-Retina
bold_font postscript_name=FiraCode-Bold
italic_font auto
bold_italic_font auto
font_size {{ .terminal.fontSize }}

# Window management
confirm_os_window_close 0
remember_window_size no
# herdr sidebar (32) plus a single OpenCode pane wide enough for 100-column diffs (~120)
initial_window_width 155c
initial_window_height 1300
remember_window_position yes

copy_on_select clipboard
enable_audio_bell no
inactive_text_alpha 0.7
mouse_hide_wait 3.0
window_padding_width 2
scrollback_lines 50000

# Pane borders
active_border_color #ff79c6
inactive_border_color #44475a

# Tab bar (Dracula theme)
tab_bar_style powerline
tab_title_template "{index}: {title}"
active_tab_foreground #282a36
active_tab_background #ff79c6
active_tab_font_style bold
inactive_tab_foreground #f8f8f2
inactive_tab_background #282a36

#
# Keybindings
#

# Reload config
map ctrl+shift+, load_config_file

# New OS window
map ctrl+shift+n new_os_window_with_cwd

# Lazygit window following the focused herdr pane's repo; a login shell supplies the PATH that
# kitty lacks when started from a desktop launcher
map ctrl+shift+g launch --type=background --allow-remote-control zsh -lc 'herdr-lazygit open'

# Pass keys to herdr - explicit unmapping required because kitty has built-in
# defaults for many of these (ctrl+shift+t=new_tab, ctrl+shift+w=close_window,
# etc). Without explicit unmapping, kitty intercepts them before herdr sees them.
# ctrl+shift+enter and cmd+enter (macOS) are unmapped so kitty cannot open its own splits.
map ctrl+shift+enter
map cmd+enter
map ctrl+shift+e
map ctrl+shift+o
map ctrl+shift+left
map ctrl+shift+right
map ctrl+shift+up
map ctrl+shift+down
map ctrl+shift+w
map ctrl+shift+t
map ctrl+alt+left
map ctrl+alt+right
map ctrl+alt+up
map ctrl+alt+down
map ctrl+shift+z
map ctrl+shift+k
map ctrl+shift+q
map ctrl+shift+b
map ctrl+shift+s

# Insert newline without executing
map shift+enter send_text all \n
