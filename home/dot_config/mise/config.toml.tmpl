# The .tmpl extension is load-bearing despite this file containing no chezmoi
# template syntax: it hides the source file from mise. Named config.toml, mise
# loads this copy as a project config whenever cwd is at or below this
# directory, then warns that trusted_config_paths and github.credential_command
# are ignored (both are global-only settings). Rendering through chezmoi keeps
# the target ~/.config/mise/config.toml the only name mise recognizes.

[tools]
age = "latest"
cosign = "latest"
d2 = "latest"
delta = "latest"
fx = "latest"
fzf = "latest"
git-filter-repo = "latest"
git-lfs = "latest"
gh = "latest"
herdr = "latest"
jq = "latest"
just = "latest"
lazygit = "latest"
lsd = "latest"
markdownlint-cli2 = "latest"
pi = "latest"
powershell = "latest"
pre-commit = "latest"
# pre-commit's zipapp runs `env python3`; without a global python the shim
# falls back to macOS /usr/bin/python3 (3.9), which pre-commit cannot run on
python = "latest"
rclone = "latest"
ripgrep = "latest"
rumdl = "latest"
task = "latest"
uv = "latest"
worktrunk = "latest"
yamllint = "latest"
yq = "latest"
zizmor = "latest"
"github:byteowlz/sx" = "latest"
"github:raine/git-surgeon" = "latest"
"github:Tyrrrz/DiscordChatExporter" = { version = "latest", matching = "Cli" }
node = "latest"
bun = "latest"
"npm:@commitlint/cli" = "latest"
"npm:@commitlint/config-conventional" = "latest"
"npm:ctx7" = "latest"
topgrade = "latest"
claude-code = "latest"

# Release assets are bare binaries; plannotator-paste-* assets make autodetection
# ambiguous, so pin the asset per platform
[tools."github:backnotprop/plannotator"]
version = "latest"
bin = "plannotator"

[tools."github:backnotprop/plannotator".platforms]
linux-x64 = { asset_pattern = "plannotator-linux-x64" }
macos-arm64 = { asset_pattern = "plannotator-darwin-arm64" }

[tools."aqua:anomalyco/opencode"]
version = "latest"
# No service restart here: during `mise upgrade` this can run before the upgrade finishes, so
# topgrade's "OpenCode plugins" command restarts the service afterward
postinstall = "opencode plugin update"

[settings]
minimum_release_age = "0d"
# both must be off so hook-env strips the shims dir from interactive PATH
# (src/path_env.rs); shims list every installed tool, active or not, which
# breaks PATH-based tool discovery (topgrade, editors) outside project dirs.
# non-interactive shells still get shims via .zshenv (mise activate --shims).
activate_aggressive = false
not_found_auto_install = false
auto_install = true
trusted_config_paths = ["~/.config/mise", "~"]
experimental = true
env_file = ".env"
netrc = false
node.verify = false

[settings.github]
credential_command = "gh auth token"

# Secrets and machine-local env vars belong in ~/.config/mise/config.local.toml,
# which mise loads automatically and chezmoi does not manage. Never add secret
# loading (files, templates, env_file) here.
[env]
# Lets npm packages installed via mise resolve each other. Inline under sh rather than a bash
# script: mise re-renders this on every cd, so process startup cost matters.
NODE_PATH = "{{ "{{" }} exec(command='for d in ~/.local/share/mise/installs/npm-*/*/node_modules; do [ -d \"$d\" ] && [ ! -L \"${d%/node_modules}\" ] && p=\"${p:+$p:}$d\"; done; printf %s \"$p\"') {{ "}}" }}"
OPENCODE_LOG_LEVEL = "DEBUG"
OPENCODE_DISABLE_FREE_MODELS = "1"
