# Model roles
{{- if eq .env "work" }}
export OPENCODE_MODEL_FAST="anthropic/claude-sonnet-5"
export OPENCODE_MODEL_BALANCED="anthropic/claude-sonnet-5"
export OPENCODE_MODEL_CAPABLE="anthropic/claude-opus-5"
{{- else }}
export OPENCODE_MODEL_FAST="openai/gpt-5.6-luna"
export OPENCODE_MODEL_BALANCED="openai/gpt-5.6-terra"
export OPENCODE_MODEL_CAPABLE="openai/gpt-5.6-sol"
{{- end }}

# Per-machine overrides (provider, agent defaults, etc.)
export OPENCODE_CONFIG="$XDG_CONFIG_HOME/opencode/opencode.local.jsonc"
