# Model roles
{{- if eq .env "work" }}
export OPENCODE_FAST_MODEL="anthropic/claude-sonnet-5"
export OPENCODE_BALANCED_MODEL="anthropic/claude-sonnet-5"
export OPENCODE_BALANCED_VARIANT="low"
export OPENCODE_CAPABLE_MODEL="anthropic/claude-opus-5"
export OPENCODE_CAPABLE_VARIANT="low"
{{- else }}
export OPENCODE_FAST_MODEL="openai/gpt-5.6-luna"
export OPENCODE_BALANCED_MODEL="openai/gpt-5.6-luna" #"openai/gpt-5.6-terra"
export OPENCODE_BALANCED_VARIANT="medium"
export OPENCODE_CAPABLE_MODEL="openai/gpt-5.6-sol"
export OPENCODE_CAPABLE_VARIANT="low"
{{- end }}

# Per-machine overrides (provider, agent defaults, etc.)
export OPENCODE_CONFIG="$XDG_CONFIG_HOME/opencode/opencode.local.jsonc"
