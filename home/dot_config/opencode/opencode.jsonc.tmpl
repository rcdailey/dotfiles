{{- $models := index .opencodeModels .opencodeProvider -}}
{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "share": "manual",
  "default_agent": "build",
  "compaction": { "auto": true },
  "agents": {
    "plan": {
      "model": {{ printf "%s#%s" $models.plan.model $models.plan.variant | quote }},
    },
    "build": {
      "model": {{ printf "%s#%s" $models.build.model $models.build.variant | quote }},
    },
    "title": {
      "model": {{ $models.title.model | quote }},
    },
    "compaction": {
      "model": {{ printf "%s#%s" $models.compaction.model $models.compaction.variant | quote }},
    },
    "general": { "disabled": true },
    "explore": {
      "model": {{ printf "%s#%s" $models.explore.model $models.explore.variant | quote }},
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" },
        { "action": "session_rename", "resource": "*", "effect": "deny" },
        { "action": "opencode_session_rename", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*> /*", "effect": "deny" },
        { "action": "shell", "resource": "*>> /*", "effect": "deny" },
        { "action": "shell", "resource": "*tee /*", "effect": "deny" },
      ],
    },
    "acceptance": {
      "model": {{ printf "%s#%s" $models.acceptance.model $models.acceptance.variant | quote }},
    },
    "researcher": {
      "model": {{ printf "%s#%s" $models.researcher.model $models.researcher.variant | quote }},
    },
    "reviewer": {
      "model": {{ printf "%s#%s" $models.reviewer.model $models.reviewer.variant | quote }},
    },
    "upgrade-analyst": {
      "model": {{ printf "%s#%s" $models.upgradeAnalyst.model $models.upgradeAnalyst.variant | quote }},
    },
  },
  "formatter": {
    "shfmt": { "disabled": true },
    "markdownlint-cli2": {
      "command": ["markdownlint-cli2", "--fix", "$FILE"],
      "extensions": [".md"],
    },
  },
  "plugins": [
    "@plannotator/opencode@latest",
{{- if eq .opencodeProvider "anthropic" }}
    // The next tag is the OpenCode V2 release line; latest is V1 and does not load in V2
    "@ex-machina/opencode-anthropic-auth@next",
{{- end }}
  ],
  // A provider block forces that provider into the model picker, even without credentials,
  // so only the selected provider may have one.
  "providers": {
{{- if eq .opencodeProvider "anthropic" }}
    "anthropic": {
      "settings": {
        // Disable hard timeout; extended thinking can exceed the 300s default
        "timeout": false,
        // Abort on genuine SSE stalls (Anthropic backend issue); triggers retry
        "chunkTimeout": 60000,
      },
    },
{{- end }}
  },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    // Disable built-in search; use the researcher for web research
    { "action": "websearch", "resource": "*", "effect": "deny" },

    // shell defaults and destructive Git operations
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*git push*", "effect": "ask" },
    { "action": "shell", "resource": "*git reset --hard*", "effect": "ask" },
    { "action": "shell", "resource": "*git clean*", "effect": "ask" },
    { "action": "shell", "resource": "*git branch -D*", "effect": "ask" },
    { "action": "shell", "resource": "*git stash drop*", "effect": "ask" },
    { "action": "shell", "resource": "*git stash clear*", "effect": "ask" },
    { "action": "shell", "resource": "*git commit*", "effect": "deny" },

    // file and system operations
    { "action": "shell", "resource": "rm -r*", "effect": "ask" },
    { "action": "shell", "resource": "rm -r* /tmp/*", "effect": "allow" },
    { "action": "shell", "resource": "sudo*", "effect": "ask" },
    { "action": "shell", "resource": "kill*", "effect": "ask" },
    { "action": "shell", "resource": "pkill*", "effect": "ask" },
    { "action": "shell", "resource": "shutdown*", "effect": "ask" },
    { "action": "shell", "resource": "reboot*", "effect": "ask" },

    // GitHub mutations
    { "action": "shell", "resource": "*gh pr create*", "effect": "ask" },
    { "action": "shell", "resource": "*gh pr merge*", "effect": "ask" },
    { "action": "shell", "resource": "*gh pr close*", "effect": "ask" },
    { "action": "shell", "resource": "*gh pr reopen*", "effect": "ask" },
    { "action": "shell", "resource": "*gh pr comment*", "effect": "ask" },
    { "action": "shell", "resource": "*gh pr edit*", "effect": "ask" },
    { "action": "shell", "resource": "*gh pr review*", "effect": "ask" },
    { "action": "shell", "resource": "*gh pr ready*", "effect": "ask" },
    { "action": "shell", "resource": "*gh issue create*", "effect": "ask" },
    { "action": "shell", "resource": "*gh issue close*", "effect": "ask" },
    { "action": "shell", "resource": "*gh issue reopen*", "effect": "ask" },
    { "action": "shell", "resource": "*gh issue delete*", "effect": "ask" },
    { "action": "shell", "resource": "*gh issue edit*", "effect": "ask" },
    { "action": "shell", "resource": "*gh issue comment*", "effect": "ask" },
    { "action": "shell", "resource": "*gh issue transfer*", "effect": "ask" },
    { "action": "shell", "resource": "*gh release create*", "effect": "ask" },
    { "action": "shell", "resource": "*gh release delete*", "effect": "ask" },
    { "action": "shell", "resource": "*gh release edit*", "effect": "ask" },
    { "action": "shell", "resource": "*gh release upload*", "effect": "ask" },
    { "action": "shell", "resource": "*gh repo create*", "effect": "ask" },
    { "action": "shell", "resource": "*gh repo delete*", "effect": "ask" },
    { "action": "shell", "resource": "*gh repo fork*", "effect": "ask" },
    { "action": "shell", "resource": "*gh repo archive*", "effect": "ask" },
    { "action": "shell", "resource": "*gh repo rename*", "effect": "ask" },
    { "action": "shell", "resource": "*gh repo edit*", "effect": "ask" },
    { "action": "shell", "resource": "*gh workflow run*", "effect": "ask" },
    { "action": "shell", "resource": "*gh run cancel*", "effect": "ask" },
    { "action": "shell", "resource": "*gh run rerun*", "effect": "ask" },
    { "action": "shell", "resource": "*gh label create*", "effect": "ask" },
    { "action": "shell", "resource": "*gh label delete*", "effect": "ask" },
    { "action": "shell", "resource": "*gh secret set*", "effect": "ask" },
    { "action": "shell", "resource": "*gh secret delete*", "effect": "ask" },
    { "action": "shell", "resource": "*gh variable set*", "effect": "ask" },
    { "action": "shell", "resource": "*gh variable delete*", "effect": "ask" },

    // The gh-api-guard plugin rejects commands without an explicit method
    { "action": "shell", "resource": "gh api*", "effect": "ask" },
    { "action": "shell", "resource": "gh api* --method GET*", "effect": "allow" },
    { "action": "shell", "resource": "*gh-review reply*", "effect": "ask" },
    { "action": "shell", "resource": "*gh-review delete*", "effect": "ask" },
    { "action": "shell", "resource": "*gh-review*--help", "effect": "allow" },

    { "action": "skill", "resource": "customize-opencode", "effect": "deny" },
    { "action": "skill", "resource": "research-cli", "effect": "deny" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.pdf", "effect": "deny" }
  ],
}
