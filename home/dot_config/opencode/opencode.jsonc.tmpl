{{- $profile := ternary "work" "personal" (eq .env "work") -}}
{{- $models := index .opencodeModels $profile -}}
{
  "$schema": "https://opencode.ai/config.json",
  "logLevel": "DEBUG",
  "autoupdate": false,
  "share": "manual",
  "compaction": { "auto": true },
  "agent": {
    "plan": { "disable": true },
    "title": {
      "model": {{ $models.title.model | quote }},
    },
    "compaction": {
      "model": {{ $models.compaction.model | quote }},
      "variant": {{ $models.compaction.variant | quote }},
    },
    "general": { "disable": true },
    "explore": {
      "model": {{ $models.explore.model | quote }},
      "variant": {{ $models.explore.variant | quote }},
      "permission": {
        "edit": "deny",
        "question": "deny",
        "session_rename": "deny",
        "bash": {
          "*": "allow",
          "*> /*": "deny",
          "*>> /*": "deny",
          "*tee /*": "deny",
        },
      },
    },
    "acceptance": {
      "model": {{ $models.acceptance.model | quote }},
      "variant": {{ $models.acceptance.variant | quote }},
    },
    "researcher": {
      "model": {{ $models.researcher.model | quote }},
      "variant": {{ $models.researcher.variant | quote }},
    },
    "reviewer": {
      "model": {{ $models.reviewer.model | quote }},
      "variant": {{ $models.reviewer.variant | quote }},
    },
    "upgrade-analyst": {
      "model": {{ $models.upgradeAnalyst.model | quote }},
      "variant": {{ $models.upgradeAnalyst.variant | quote }},
    },
  },
  "formatter": {
    "shfmt": { "disabled": true },
    "markdownlint-cli2": {
      "command": ["markdownlint-cli2", "--fix", "$FILE"],
      "extensions": [".md"],
    },
  },
  "plugin": [
    ["@plannotator/opencode@latest", { "workflow": "all-agents" }],
{{- if eq .env "work" }}
    "opencode-claude-auth@latest",
{{- end }}
  ],
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "limit": { "context": 400000, "input": 272000, "output": 128000 },
        },
        "gpt-5.6-terra": {
          "limit": { "context": 400000, "input": 272000, "output": 128000 },
        },
      },
    },
    "anthropic": {
      "options": {
        // Disable hard timeout; extended thinking can exceed the 300s default
        "timeout": false,
        // Abort on genuine SSE stalls (Anthropic backend issue); triggers retry
        "chunkTimeout": 60000,
      },
    },
  },
  "permission": {
    "*": "allow",
    // Disable built-in search; use the researcher for web research
    "websearch": "deny",
    // "webfetch": "deny",

    "bash": {
      "*": "allow",
      // grep redirection handled by tool-guards plugin (allows kubectl exec, git, etc)

      // git (destructive)
      "*git push*": "ask",
      "*git reset --hard*": "ask",
      "*git clean*": "ask",
      "*git branch -D*": "ask",
      "*git stash drop*": "ask",
      "*git stash clear*": "ask",
      "*git commit*": "deny",
      // "git add*": "ask",

      // file operations
      "rm -r*": "ask",

      // system
      "sudo*": "ask",
      "kill*": "ask",
      "pkill*": "ask",
      "shutdown*": "ask",
      "reboot*": "ask",

      // github cli
      // '*' at start catches corner cases like `xargs -I{} gh api ...`
      "*gh pr create*": "ask",
      "*gh pr merge*": "ask",
      "*gh pr close*": "ask",
      "*gh pr reopen*": "ask",
      "*gh pr comment*": "ask",
      "*gh pr edit*": "ask",
      "*gh pr review*": "ask",
      "*gh pr ready*": "ask",
      "*gh issue create*": "ask",
      "*gh issue close*": "ask",
      "*gh issue reopen*": "ask",
      "*gh issue delete*": "ask",
      "*gh issue edit*": "ask",
      "*gh issue comment*": "ask",
      "*gh issue transfer*": "ask",
      "*gh release create*": "ask",
      "*gh release delete*": "ask",
      "*gh release edit*": "ask",
      "*gh release upload*": "ask",
      "*gh repo create*": "ask",
      "*gh repo delete*": "ask",
      "*gh repo fork*": "ask",
      "*gh repo archive*": "ask",
      "*gh repo rename*": "ask",
      "*gh repo edit*": "ask",
      "*gh workflow run*": "ask",
      "*gh run cancel*": "ask",
      "*gh run rerun*": "ask",
      "*gh label create*": "ask",
      "*gh label delete*": "ask",
      "*gh secret set*": "ask",
      "*gh secret delete*": "ask",
      "*gh variable set*": "ask",
      "*gh variable delete*": "ask",
      "*gh api* --method POST*": "ask",
      "*gh api* --method PUT*": "ask",
      "*gh api* --method PATCH*": "ask",
      "*gh api* --method DELETE*": "ask",
      "*gh api* -X POST*": "ask",
      "*gh api* -X PUT*": "ask",
      "*gh api* -X PATCH*": "ask",
      "*gh api* -X DELETE*": "ask",
      // gh api implies POST when data flags are present without explicit method
      "*gh api* -f *": "ask",
      "*gh api* -F *": "ask",
      "*gh api* --field *": "ask",
      "*gh api* --raw-field *": "ask",
      "*gh api* --input *": "ask",

      // gh-review script
      "*gh-review reply*": "ask",
      "*gh-review delete*": "ask",
      "*gh-review*--help": "allow",
    },
    "skill": {
      "customize-opencode": "deny",
    },
    "read": {
      "*": "allow",
      "*.pdf": "deny", // use pdf2md instead
    },
  },
}
