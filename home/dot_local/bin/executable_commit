#!/usr/bin/env -S uv run --script
"""commit - deterministic workflow tool for LLM-driven git commits.

Stages changes and creates consistently formatted commits without multi-step
Git command sequences.

Usage:
    commit save [files] -s "..." [-p "..."] [-b "..."] [-i "..."]

Environment:
    GIT_COMMIT_FMT_SUBJECT_WIDTH  Subject char limit (default: 72)
    GIT_COMMIT_FMT_BODY_WIDTH     Body wrap width (default: 72)
"""

from __future__ import annotations

import argparse
import hashlib
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import textwrap
from pathlib import Path
from typing import NoReturn

# Suppress pager and ANSI colors for non-tty environments
os.environ["GIT_PAGER"] = "cat"
os.environ["GIT_CONFIG_COUNT"] = str(
    int(os.environ.get("GIT_CONFIG_COUNT", "0")) + 1
)
_idx = str(int(os.environ["GIT_CONFIG_COUNT"]) - 1)
os.environ[f"GIT_CONFIG_KEY_{_idx}"] = "color.ui"
os.environ[f"GIT_CONFIG_VALUE_{_idx}"] = "false"

SUBJECT_WIDTH = int(os.environ.get("GIT_COMMIT_FMT_SUBJECT_WIDTH", 72))
BODY_WIDTH = int(os.environ.get("GIT_COMMIT_FMT_BODY_WIDTH", 72))

USAGE = """\
usage: commit <subcommand> [args...]

subcommands:
  save [files] -s "..."      stage files and commit

Use 'commit <subcommand> --help' for subcommand details."""


def die(message: str) -> NoReturn:
    print(f"error: {message}", file=sys.stderr)
    sys.exit(1)


def git(*args: str, check: bool = True, capture: bool = False) -> subprocess.CompletedProcess:
    """Run a git command."""
    cmd = ["git", *args]
    return subprocess.run(
        cmd,
        check=check,
        capture_output=capture,
        text=True,
    )


def git_output(*args: str) -> str:
    """Run a git command and return stdout."""
    result = git(*args, check=True, capture=True)
    return result.stdout


def git_bytes(*args: str) -> bytes:
    """Run a git command and return stdout without decoding paths or content."""
    result = subprocess.run(
        ["git", *args],
        check=True,
        capture_output=True,
    )
    return result.stdout


def print_section(header: str, content: str) -> None:
    """Print a labeled section."""
    print(f"=== {header} ===")
    print(content, end="" if content.endswith("\n") else "\n")


# -- save ------------------------------------------------------------------

_BARE_HEADER_RE = re.compile(r"^[\w /'-]{1,30}:\s*$")


def wrap_paragraph(text: str) -> str:
    """Wrap a plain-text paragraph to BODY_WIDTH."""
    return textwrap.fill(text.strip(), width=BODY_WIDTH)


def wrap_bullet(text: str) -> str:
    """Wrap a technical outline bullet with continuation indent."""
    return textwrap.fill(
        text.strip(),
        width=BODY_WIDTH,
        initial_indent="- ",
        subsequent_indent="  ",
    )


def validate_paragraphs(paragraphs: list[str]) -> list[str]:
    """Reject -p values that should be -b entries or are bare headers."""
    errors = []
    for p in paragraphs:
        stripped = p.strip()
        if stripped.startswith(("- ", "* ")):
            label = f'"{stripped[:40]}..."' if len(stripped) > 40 else f'"{stripped}"'
            errors.append(f"-p looks like a bullet item: {label}")
            errors.append("  use -b for technical outline bullets instead")
        elif _BARE_HEADER_RE.match(stripped):
            errors.append(f'-p looks like a bare header: "{stripped}"')
            errors.append(
                "  headers are unnecessary; -b entries render"
                " as bullets automatically"
            )
    return errors


def validate_literal_line_breaks(options: dict[str, list[str]]) -> list[str]:
    """Reject escaped line breaks that should be repeated CLI options."""
    errors = []
    for option, values in options.items():
        for value in values:
            if not re.search(r"\\[nr]", value):
                continue
            errors.append(
                f'{option} contains a literal "\\n" or "\\r" escape'
            )
            if option == "-s":
                errors.append("  use a single-line -s value instead")
            else:
                errors.append(f"  use repeated {option} options instead")
    return errors


def _stage_files(files: list[str]) -> None:
    """Stage complete paths without disturbing other index entries."""
    git("add", "-A", "--", *files)


def _repo_relative(path: str, repo_root: Path) -> str:
    """Express a caller path relative to the repository root."""
    return os.path.relpath(os.path.abspath(path), repo_root)


def _staged_paths() -> list[str]:
    """List staged paths, representing a rename by its destination only.

    A staged rename source no longer exists in the worktree or the index, so
    `git add` cannot match it. Naming the destination is the only way a caller
    can express a `git mv`, so the destination stands for the whole rename.
    """
    fields = [
        os.fsdecode(field)
        for field in git_bytes(
            "diff", "--cached", "--name-status", "-z", "-M"
        ).split(b"\0")
        if field
    ]
    paths = []
    index = 0
    while index < len(fields):
        status = fields[index]
        # Rename and copy statuses carry a similarity score and two paths.
        if status[0] in ("R", "C"):
            paths.append(fields[index + 2])
            index += 3
            continue
        paths.append(fields[index + 1])
        index += 2
    return paths


def _uncovered_staged_paths(files: list[str], repo_root: Path) -> list[str]:
    """Return staged paths the caller's file arguments do not account for."""
    prefixes = [_repo_relative(f, repo_root) for f in files]
    return [
        path
        for path in _staged_paths()
        if not any(
            path == prefix or path.startswith(f"{prefix}/") for prefix in prefixes
        )
    ]


def format_message(
    subject: str,
    paragraphs: list[str],
    bullets: list[str],
    issues: list[str],
) -> str:
    """Assemble the full commit message in enforced structural order."""
    parts = [subject]
    body_sections = []

    if paragraphs:
        body_sections.append(
            "\n\n".join(wrap_paragraph(p) for p in paragraphs)
        )

    if bullets:
        body_sections.append(
            "\n".join(wrap_bullet(bullet) for bullet in bullets)
        )

    if issues:
        body_sections.append("\n".join(i.strip() for i in issues))

    if body_sections:
        parts.append("")
        parts.append("\n\n".join(body_sections))

    return "\n".join(parts) + "\n"


def _commit_output(result: subprocess.CompletedProcess) -> str:
    """Merge git commit's stdout and stderr in that order."""
    return (result.stdout or "") + (result.stderr or "")


def _untracked_digest(repo_root: Path) -> bytes:
    """Hash untracked paths and content without following symbolic links."""
    digest = hashlib.sha256()
    paths = git_bytes(
        "ls-files",
        "--others",
        "--exclude-standard",
        "--full-name",
        "-z",
    )
    for raw_path in paths.split(b"\0"):
        if not raw_path:
            continue
        digest.update(len(raw_path).to_bytes(8, "big"))
        digest.update(raw_path)

        path = repo_root / os.fsdecode(raw_path)
        try:
            file_stat = path.lstat()
        except FileNotFoundError:
            digest.update(b"missing")
            continue

        file_type = stat.S_IFMT(file_stat.st_mode)
        digest.update(file_type.to_bytes(4, "big"))
        if stat.S_ISLNK(file_stat.st_mode):
            digest.update(os.fsencode(os.readlink(path)))
            continue
        if not stat.S_ISREG(file_stat.st_mode):
            digest.update(file_stat.st_size.to_bytes(8, "big"))
            digest.update(file_stat.st_mtime_ns.to_bytes(8, "big"))
            continue

        with path.open("rb") as file:
            while chunk := file.read(1024 * 1024):
                digest.update(chunk)
    return digest.digest()


def _commit_state(repo_root: Path) -> tuple[bytes, bytes, bytes, bytes]:
    """Fingerprint visible paths and commit-relevant repository content."""
    status = git_bytes("status", "--porcelain", "-z")
    staged = git_bytes("diff", "--cached", "--binary", "--no-ext-diff")
    unstaged = git_bytes("diff", "--binary", "--no-ext-diff")
    return (
        status,
        hashlib.sha256(staged).digest(),
        hashlib.sha256(unstaged).digest(),
        _untracked_digest(repo_root),
    )


def cmd_save(args: list[str]) -> None:
    parser = argparse.ArgumentParser(prog="commit save")
    parser.add_argument("files", nargs="*", help="whole files to stage")
    parser.add_argument("-s", required=True, help="subject")
    parser.add_argument("-p", action="append", default=[], help="body paragraph")
    parser.add_argument(
        "-b",
        action="append",
        default=[],
        help="technical outline bullet",
    )
    parser.add_argument("-i", action="append", default=[], help="issue reference")
    parser.add_argument("-a", action="store_true", help="stage all changes")
    args_parsed = parser.parse_args(args)

    has_files = bool(args_parsed.files)

    if args_parsed.a and has_files:
        die("-a and file arguments are mutually exclusive")

    if "\n" in args_parsed.s or "\r" in args_parsed.s:
        die("subject must be a single line")
    subject = args_parsed.s.strip()
    if not subject:
        die("subject must not be empty")
    if len(subject) > SUBJECT_WIDTH:
        die(
            f"subject is {len(subject)} chars, exceeds"
            f" {SUBJECT_WIDTH}-char limit"
        )

    errors = validate_literal_line_breaks(
        {
            "-s": [subject],
            "-p": args_parsed.p,
            "-b": args_parsed.b,
            "-i": args_parsed.i,
        }
    )
    errors.extend(validate_paragraphs(args_parsed.p))
    if errors:
        for err in errors:
            print(f"error: {err}", file=sys.stderr)
        sys.exit(1)

    repo_root = Path(git_output("rev-parse", "--show-toplevel").strip())

    staged = git("diff", "--cached", "--quiet", check=False, capture=True)
    if staged.returncode not in (0, 1):
        die(staged.stderr.strip() or "could not inspect the index")
    if staged.returncode == 1:
        if args_parsed.a:
            die(
                "index is not empty; inspect it, then use staged-only mode"
                " or clear it explicitly"
            )
        uncovered = (
            _uncovered_staged_paths(args_parsed.files, repo_root)
            if has_files
            else []
        )
        if uncovered:
            listing = "\n".join(f"  {path}" for path in uncovered)
            die(
                "index holds staged paths outside the files you named:\n"
                f"{listing}\n"
                "  name them too, use staged-only mode, or clear the index"
            )

    message = format_message(subject, args_parsed.p, args_parsed.b, args_parsed.i)

    def stage() -> None:
        """Put the caller's requested content into the index."""
        if has_files:
            _stage_files(args_parsed.files)
        elif args_parsed.a:
            git("add", "-A")

        stat = git_output("diff", "--cached", "--stat")
        if not stat.strip():
            die("nothing staged; pass files or -a")
        print_section("STAGED", stat)
        sys.stdout.flush()

    stage()

    fd, msg_path = tempfile.mkstemp(prefix="commit-msg-", suffix=".txt")
    index_backup: Path | None = None
    try:
        with os.fdopen(fd, "w") as f:
            f.write(message)

        index_path = Path(
            git_output(
                "rev-parse",
                "--path-format=absolute",
                "--git-path",
                "index",
            ).strip()
        )
        index_fd, index_backup_name = tempfile.mkstemp(
            prefix="commit-index-",
            dir=index_path.parent,
        )
        os.close(index_fd)
        index_backup = Path(index_backup_name)
        shutil.copy2(index_path, index_backup)

        repository_state_before = _commit_state(repo_root)
        result = git("commit", "-F", msg_path, check=False, capture=True)

        repository_state_changed = False
        if result.returncode != 0:
            repository_state_after = _commit_state(repo_root)
            repository_state_changed = (
                repository_state_after != repository_state_before
            )
            if repository_state_after[1] != repository_state_before[1]:
                os.replace(index_backup, index_path)

        if result.returncode == 0:
            print(_commit_output(result), end="")
            sha_line = git_output("log", "--oneline", "-1").strip()
            print(f"\n=== COMMITTED === {sha_line}")
        else:
            print(_commit_output(result), end="", file=sys.stderr)
            if repository_state_changed:
                print(
                    "\n=== REPOSITORY CHANGED DURING COMMIT; REVIEW BEFORE RETRYING ===",
                    file=sys.stderr,
                )
            print("\n=== COMMIT FAILED ===", file=sys.stderr)
        sys.exit(result.returncode)
    finally:
        os.unlink(msg_path)
        if index_backup is not None:
            index_backup.unlink(missing_ok=True)


# -- main ------------------------------------------------------------------

COMMANDS = {
    "save": cmd_save,
}


def main() -> None:
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(USAGE)
        sys.exit(0 if len(sys.argv) >= 2 else 2)

    subcmd = sys.argv[1]
    if subcmd not in COMMANDS:
        print(USAGE, file=sys.stderr)
        die(f"unknown subcommand '{subcmd}'")

    COMMANDS[subcmd](sys.argv[2:])


if __name__ == "__main__":
    main()
