#!/usr/bin/env bash
# List open Renovate and Dependabot PRs ranked for review: security, major/unknown, minor, patch,
# oldest first.
# Checks summarize the status rollup: fail (any check failed), pending (any check unfinished),
# none (no checks), or pass.
# Update type is best effort (bot config varies per repo); the first signal found wins:
# label, "(major)" style title suffix, then the version change in the title
# ("1.2 -> 1.3" or Dependabot's "from 1.2 to 1.3").
# Output: one line per PR:
# <number> <checks> <type>/<signal> <created> [security] <author> <title> [<labels>]
# (security and labels appear only when present).
# Extra arguments pass through to `gh pr list` (e.g. --repo owner/name).
set -euo pipefail

fields=number,title,labels,createdAt,author,statusCheckRollup
for author in app/renovate app/dependabot; do
  gh pr list --author "$author" --state open --limit 100 --json "$fields" "$@"
done | jq -rs '
def semver_type($a; $b): [$a, $b] | map(ltrimstr("v") | split(".")) as [$x, $y]
  | if $x[0] != $y[0] then "major" elif $x[1] != $y[1] then "minor" else "patch" end;
def checks: [.statusCheckRollup[] | (.conclusion // .state) as $s
    | if $s == "SUCCESS" or $s == "NEUTRAL" or $s == "SKIPPED" then "pass"
      elif $s == "" or $s == "PENDING" or $s == "EXPECTED" then "pending"
      else "fail" end]
  | if . == [] then "none" elif any(. == "fail") then "fail"
    elif any(. == "pending") then "pending" else "pass" end;
add
| map(
  [.labels[].name] as $labels
  | ([
      ($labels | map(capture("\\b(?<t>major|minor|patch)\\b"; "i").t) | first
        | select(.) | {t: ., s: "label"}),
      (.title | capture("\\((?<t>major|minor|patch)\\)"; "i") | {t, s: "title"}),
      (.title
        | capture("(?<a>v?\\d+(\\.\\d+)*)( *(->|[→➜➔]) *| +to +)(?<b>v?\\d+(\\.\\d+)*)")
        | {t: semver_type(.a; .b), s: "version"})
    ] | first // {t: "unknown", s: "none"}) as $type
  | {number, title, labels: $labels, createdAt, author: .author.login, checks: checks,
     security: any($labels[]; test("security|vulnerab"; "i")),
     type: ($type.t | ascii_downcase), signal: $type.s})
| sort_by((if .security then 0 else 1 end),
    ({major: 0, unknown: 0, minor: 1, patch: 2}[.type]), .createdAt)
| .[]
| [.number, .checks, "\(.type)/\(.signal)", .createdAt[:10],
   (if .security then "security" else empty end), .author, .title,
   (if .labels == [] then empty else "[\(.labels | join(","))]" end)]
| join(" ")'
