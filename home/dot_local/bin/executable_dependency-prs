#!/usr/bin/env bash
# List open Renovate and Dependabot PRs ranked for review: security, major/unknown, minor, patch,
# oldest first.
# Checks summarize the status rollup: fail (any check failed), pending (any check unfinished),
# none (no checks), or pass.
# Update type is best effort (bot config varies per repo); the first signal found wins:
# label, "(major)" style title suffix, then the version change in the title
# ("1.2 -> 1.3" or Dependabot's "from 1.2 to 1.3").
# Security marks PRs whose package has an open Dependabot alert (security=<GHSA IDs>) or whose
# labels mention security (bare security). Packages come from title words and the linked names on
# the body's first line (Dependabot lists grouped packages there). Alert PR links are not used;
# GitHub attaches them to the wrong PRs.
# Output: header lines, then one line per PR:
# merge <base> <method>      (one per PR base branch)
# alerts unavailable         (alerts disabled or unreadable; security then relies on labels)
# truncated <prs|alerts> <n> (only when a list exceeds the query's 100-item page)
# <number> <checks> <type>/<signal> <created> [security[=<ghsa>,...]] [base=<base>] <author>
#   <title> [<labels>]
# Method is the `gh pr merge` method the base branch accepts: rebase, else squash, else none.
# Merge commits are never offered. Repo settings and branch rulesets must both allow the method.
# Security, labels, and base (only with multiple bases) appear only when present.
# Optional argument: owner/name (default: the current directory's repository).
# One GraphQL call fetches everything to keep wall time and rate-limit cost low. It reads the 100
# newest open PRs of any author; if `truncated prs` appears, switch to per-author search queries.
set -euo pipefail

if [[ $# -gt 0 ]]; then export GH_REPO=$1; fi
query='query($owner: String!, $name: String!) {
  repository(owner: $owner, name: $name) {
    rebaseMergeAllowed squashMergeAllowed hasVulnerabilityAlertsEnabled
    vulnerabilityAlerts(states: OPEN, first: 100) {
      totalCount
      nodes { securityVulnerability { package { name } } securityAdvisory { ghsaId } }
    }
    pullRequests(states: OPEN, first: 100, orderBy: {field: CREATED_AT, direction: DESC}) {
      totalCount
      nodes {
        number title body createdAt
        author { login }
        labels(first: 20) { nodes { name } }
        commits(last: 1) { nodes { commit { statusCheckRollup { state } } } }
        baseRef { name rules(first: 50) { nodes { type parameters {
          ... on PullRequestParameters { allowedMergeMethods } } } } }
      }
    }
  }
}'
# Alert access errors still return the rest of the data; jq reports them as alerts unavailable.
response=$(gh api graphql --method POST -F owner='{owner}' -F name='{repo}' -f query="$query" ||
  true)

jq -r '
def semver_type($a; $b): [$a, $b] | map(ltrimstr("v") | split(".")) as [$x, $y]
  | if $x[0] != $y[0] then "major" elif $x[1] != $y[1] then "minor" else "patch" end;
def checks: (.commits.nodes[0].commit.statusCheckRollup.state // "") as $s
  | if $s == "" then "none" elif $s == "SUCCESS" then "pass"
    elif $s == "PENDING" or $s == "EXPECTED" then "pending" else "fail" end;
def merge_method($allowed): [.rules.nodes[] | select(.type == "PULL_REQUEST")
    | .parameters.allowedMergeMethods | map(ascii_downcase)]
  | reduce .[] as $rule ($allowed; map(select(IN($rule[])))) | first // "none";
(.data.repository // ("dependency-prs: GitHub query failed\n" | halt_error(1))) as $repo
| [("rebase" | select($repo.rebaseMergeAllowed)),
   ("squash" | select($repo.squashMergeAllowed))] as $allowed
| [$repo.vulnerabilityAlerts.nodes[]?
    | {package: .securityVulnerability.package.name, ghsa: .securityAdvisory.ghsaId}] as $alerts
| [$repo.pullRequests.nodes[] | select(.author.login | IN("renovate", "dependabot"))] as $prs
| ($prs | map(.baseRef) | unique_by(.name)) as $bases
| select($prs != [])
| ($bases[] | "merge \(.name) \(merge_method($allowed))"),
  ($repo.pullRequests.totalCount | select(. > 100) | "truncated prs \(.)"),
  ($repo.vulnerabilityAlerts.totalCount // 0 | select(. > 100) | "truncated alerts \(.)"),
  (if $repo.hasVulnerabilityAlertsEnabled and $repo.vulnerabilityAlerts then empty
   else "alerts unavailable" end),
  ($prs | map(
  [.labels.nodes[].name] as $labels
  | ([
      ($labels | map(capture("\\b(?<t>major|minor|patch)\\b"; "i").t) | first
        | select(.) | {t: ., s: "label"}),
      (.title | capture("\\((?<t>major|minor|patch)\\)"; "i") | {t, s: "title"}),
      (.title
        | capture("(?<a>v?\\d+(\\.\\d+)*)( *(->|[→➜➔]) *| +to +)(?<b>v?\\d+(\\.\\d+)*)")
        | {t: semver_type(.a; .b), s: "version"})
    ] | first // {t: "unknown", s: "none"}) as $type
  | ((.title | split(" ")) + [.body | split("\n")[0] | scan("\\[([^]]+)\\]\\(")[0]]) as $names
  | {number, title, labels: $labels, createdAt, author: "app/\(.author.login)", checks: checks,
     base: .baseRef.name,
     advisories: ([$alerts[] | select(.package | IN($names[])).ghsa] | unique),
     security_label: any($labels[]; test("security|vulnerab"; "i")),
     type: ($type.t | ascii_downcase), signal: $type.s}
  | .security = (.advisories != [] or .security_label))
  | sort_by((if .security then 0 else 1 end),
      ({major: 0, unknown: 0, minor: 1, patch: 2}[.type]), .createdAt)
  | .[]
  | [.number, .checks, "\(.type)/\(.signal)", .createdAt[:10],
     (if .advisories != [] then "security=\(.advisories | join(","))"
      elif .security then "security" else empty end),
     (if ($bases | length) > 1 then "base=\(.base)" else empty end), .author, .title,
     (if .labels == [] then empty else "[\(.labels | join(","))]" end)]
  | join(" "))' <<<"$response"
