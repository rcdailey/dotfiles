#!/usr/bin/env bash
# Turn a herdr shell pane into the agent layout: OpenCode in that pane, a shell split to its right.
# Usage: herdr-agent-split <pane_id>
set -euo pipefail

pane="${1:?Usage: herdr-agent-split <pane_id>}"
herdr pane split "$pane" --direction right >/dev/null
# Typed input waits in the terminal until zsh finishes startup, unlike `agent start`, which
# rejects a pane whose startup commands still hold the foreground
herdr pane run "$pane" opencode >/dev/null
