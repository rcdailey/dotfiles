#!/usr/bin/env bash
# Lazygit in its own kitty OS window that follows the focused herdr pane's git repository.
#   herdr-lazygit open    focus the window, or open it if closed (kitty ctrl+shift+g)
#   herdr-lazygit run     window process: run lazygit, restarting it when the followed repo changes;
#                         opened outside a git repo, it waits for follow to supply one
#   herdr-lazygit follow  herdr focus hook: retarget an open window at the focused pane's repo
# A repo switch stops lazygit with SIGTERM, so anything unsaved inside lazygit is lost.
set -euo pipefail

state="${XDG_STATE_HOME:-$HOME/.local/state}/herdr-lazygit"
# Identifies the window to kitty; a title would not work because lazygit rewrites it
window_match="var:herdr_lazygit"

# Toplevel of the focused herdr pane's repo (a linked worktree resolves to its own root)
focused_repo() {
  local cwd
  # Without HERDR_PANE_ID, `pane current` reports the focused pane instead of the calling one
  cwd=$(env -u HERDR_PANE_ID herdr pane current | jq -r '.result.pane.cwd // empty')
  [[ -n "$cwd" ]] && git -C "$cwd" rev-parse --show-toplevel 2>/dev/null
}

lazygit_running() {
  local pid
  pid=$(cat "$state/pid" 2>/dev/null) && kill -0 "$pid" 2>/dev/null
}

window_waiting() {
  local pid
  pid=$(cat "$state/waiting" 2>/dev/null) && kill -0 "$pid" 2>/dev/null
}

# Keeps the window open until follow records a repo (printed) or the user presses q (fails)
wait_for_repo() {
  : >"$state/repo"
  echo $$ >"$state/waiting"
  echo "Waiting for a herdr pane in a git repository. Press q to close." >&2
  local key repo
  while :; do
    repo=$(cat "$state/repo")
    if [[ -n "$repo" ]]; then
      rm -f "$state/waiting"
      echo "$repo"
      return
    fi
    if read -rsn1 -t 1 key; then
      [[ "$key" != q ]] || return 1
    elif (($? <= 128)); then
      # EOF rather than a timeout: without this, a closed stdin spins the loop
      sleep 1
    fi
  done
}

open() {
  kitten @ focus-window --match "$window_match" 2>/dev/null && return
  local id
  # Login shell for the user environment (.zshenv). Not interactive: .zshrc starts prompt helpers
  # that outlive the shell and hold the window open for seconds after lazygit quits.
  id=$(kitten @ launch --type=os-window --var herdr_lazygit=1 zsh -lc 'herdr-lazygit run')
  # Landscape, unlike kitty's portrait initial_window_* default sized for the herdr window
  kitten @ resize-os-window --match "id:$id" --unit pixels --width 1500 --height 800
}

run() {
  mkdir -p "$state"
  trap 'rm -f "$state/pid" "$state/waiting"' EXIT
  local repo
  repo=$(focused_repo) || repo=$(wait_for_repo) || exit 0
  echo "$repo" >"$state/repo"
  while :; do
    # sh records its own PID, which exec hands to lazygit, so follow can stop lazygit
    sh -c 'echo $$ >"$1" && cd "$2" && exec lazygit' sh "$state/pid" "$repo" || true
    local next
    next=$(cat "$state/repo")
    if [[ "$next" == "$repo" ]]; then
      # An unchanged repo that still exists means the user quit lazygit. A deleted one (a removed
      # worktree) crashed it: retarget at the focused pane's repo instead of closing the window.
      [[ ! -d "$repo" ]] || exit 0
      next=$(focused_repo) || next=$(wait_for_repo) || exit 0
      echo "$next" >"$state/repo"
    fi
    repo=$next
  done
}

follow() {
  lazygit_running || window_waiting || return 0
  local repo
  repo=$(focused_repo) || return 0
  [[ "$repo" != "$(cat "$state/repo" 2>/dev/null)" ]] || return 0
  echo "$repo" >"$state/repo"
  # A waiting window has no lazygit to stop; it polls the repo file instead. lazygit may also have
  # exited since the check.
  kill "$(cat "$state/pid" 2>/dev/null)" 2>/dev/null || true
}

case "${1-}" in
  open | run | follow) "$1" ;;
  *)
    echo "Usage: herdr-lazygit open|run|follow" >&2
    exit 2
    ;;
esac
