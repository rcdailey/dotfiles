#!/usr/bin/env bash
# Close the herdr child space of a removed worktree. Run by worktrunk's post-remove hook.
# Usage: herdr-worktree-close <worktree_path>
set -euo pipefail

worktree="${1:?Usage: herdr-worktree-close <worktree_path>}"
[[ -n "${HERDR_ENV-}" ]] || exit 0

# wt remove deletes the directory in a background process that dies with the space; closing the
# space first leaves an empty directory and an undeleted trash copy. Wait up to 60s for removal.
for _ in {1..120}; do
  [[ -e "$worktree" ]] || break
  sleep 0.5
done

herdr workspace list |
  jq -r --arg path "$worktree" \
    '.result.workspaces[] | select(.worktree.checkout_path? == $path) | .workspace_id' |
  while read -r workspace; do
    herdr workspace close "$workspace" >/dev/null
  done
