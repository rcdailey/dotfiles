#!/usr/bin/env python3

import argparse
import json
import os
import subprocess
import sys
import time
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path
from urllib.parse import quote


class CleanupError(Exception):
    pass


@dataclass(frozen=True)
class Session:
    id: str
    title: str
    updated: int
    project_id: str
    directory: str


def positive_days(value: str) -> int:
    try:
        days = int(value)
    except ValueError as error:
        raise argparse.ArgumentTypeError("must be a whole number") from error

    if days < 1:
        raise argparse.ArgumentTypeError("must be at least 1")
    return days


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="opencode-prune-sessions",
        description="Delete OpenCode sessions not updated within the given number of days.",
    )
    parser.add_argument("days", type=positive_days, help="minimum session age in days")
    return parser.parse_args()


def opencode_api(method: str, path: str, **params: str) -> object | None:
    command = ["opencode", "api", method, path]
    for key, value in params.items():
        command.extend(["--param", f"{key}={value}"])
    try:
        result = subprocess.run(
            command,
            text=True,
            capture_output=True,
            check=True,
        )
    except FileNotFoundError as error:
        raise CleanupError("OpenCode V2 is not installed or not on PATH") from error
    except subprocess.CalledProcessError as error:
        detail = error.stderr.strip() or error.stdout.strip() or "unknown error"
        raise CleanupError(f"OpenCode API request failed: {detail}") from error

    output = result.stdout.strip()
    if not output:
        return None
    try:
        return json.loads(output)
    except json.JSONDecodeError as error:
        raise CleanupError("OpenCode returned malformed JSON") from error


def parse_updated(value: object) -> int:
    if isinstance(value, (int, float)):
        return int(value)
    if not isinstance(value, str):
        raise CleanupError("OpenCode returned a session without an update time")
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError as error:
        raise CleanupError(f"OpenCode returned an invalid update time: {value}") from error
    return int(parsed.timestamp() * 1_000)


def session_from_json(value: object) -> Session:
    if not isinstance(value, dict):
        raise CleanupError("OpenCode returned an invalid session")
    location = value.get("location")
    timestamp = value.get("time")
    if not isinstance(location, dict) or not isinstance(timestamp, dict):
        raise CleanupError("OpenCode returned incomplete session metadata")
    try:
        session_id = value["id"]
        project_id = value["projectID"]
        directory = location["directory"]
        title = value.get("title")
        if not isinstance(session_id, str) or not isinstance(project_id, str):
            raise CleanupError("OpenCode returned an invalid session ID")
        if not isinstance(directory, str) or (title is not None and not isinstance(title, str)):
            raise CleanupError("OpenCode returned invalid session metadata")
        return Session(
            id=session_id,
            title=title or "Untitled session",
            updated=parse_updated(timestamp["updated"]),
            project_id=project_id,
            directory=directory,
        )
    except KeyError as error:
        raise CleanupError(f"OpenCode omitted session field: {error.args[0]}") from error


def list_sessions(parent_id: str | None) -> list[Session]:
    sessions = []
    cursor = None
    seen = set()
    while True:
        params = {"parentID": parent_id or "null", "order": "asc", "limit": "100"}
        if cursor:
            params["cursor"] = cursor
        page = opencode_api("get", "/api/session", **params)
        if not isinstance(page, dict) or not isinstance(page.get("data"), list):
            raise CleanupError("OpenCode returned an invalid session page")
        sessions.extend(session_from_json(value) for value in page["data"])
        cursors = page.get("cursor")
        next_cursor = cursors.get("next") if isinstance(cursors, dict) else None
        if not next_cursor:
            return sessions
        if not isinstance(next_cursor, str) or next_cursor in seen:
            raise CleanupError("OpenCode returned a repeated pagination cursor")
        seen.add(next_cursor)
        cursor = next_cursor


def load_sessions(cutoff: int) -> list[Session]:
    return [session for session in list_sessions(None) if session.updated < cutoff]


def format_updated(updated: int) -> str:
    return datetime.fromtimestamp(updated / 1_000).astimezone().isoformat(timespec="seconds")


def confirm_deletion(sessions: list[Session], days: int) -> bool:
    print(f"Found {len(sessions)} session(s) not updated in more than {days} days:")
    candidates = [("Oldest", sessions[0])]
    if len(sessions) > 1:
        candidates.append(("Newest", sessions[-1]))
    for label, session in candidates:
        title = json.dumps(session.title, ensure_ascii=False)
        print(f"{label}: {format_updated(session.updated)}  {session.id}  {title}")

    try:
        answer = input(
            f"\nDelete these {len(sessions)} session tree(s), including child sessions? [y/N] "
        )
    except EOFError:
        return False
    return answer.strip().lower() in {"y", "yes"}


def session_tree(session_id: str) -> list[Session]:
    value = opencode_api("get", f"/api/session/{quote(session_id, safe='')}")
    root = session_from_json(value)
    descendants = []
    pending = [session_id]
    seen = {session_id}
    while pending:
        children = list_sessions(pending.pop())
        if any(child.id in seen for child in children):
            raise CleanupError("OpenCode returned a cyclic or repeated session tree")
        seen.update(child.id for child in children)
        descendants.extend(children)
        pending.extend(child.id for child in children)
    return [root, *descendants]


def active_session_ids() -> set[str]:
    active = opencode_api("get", "/api/session/active")
    if not isinstance(active, dict):
        raise CleanupError("OpenCode returned invalid active-session data")
    if not all(isinstance(session_id, str) for session_id in active):
        raise CleanupError("OpenCode returned an invalid active session ID")
    return set(active)


def delete_session(session_id: str) -> None:
    result = opencode_api("delete", f"/api/session/{quote(session_id, safe='')}")
    if result is not None:
        raise CleanupError("OpenCode returned unexpected deletion output")


def diagnostics_path() -> Path:
    state_home = os.environ.get("XDG_STATE_HOME")
    state_root = Path(state_home).expanduser() if state_home else Path.home() / ".local/state"
    diagnostics_dir = state_root / "opencode-prune-sessions"
    try:
        diagnostics_dir.mkdir(parents=True, exist_ok=True)
    except OSError as error:
        raise CleanupError(f"could not create the diagnostics directory: {error}") from error
    return diagnostics_dir / "last-run.jsonl"


def record_metric(metrics: object, event: str, **fields: object) -> None:
    payload = {
        "timestamp": datetime.now().astimezone().isoformat(timespec="milliseconds"),
        "event": event,
        **fields,
    }
    print(json.dumps(payload, ensure_ascii=False), file=metrics, flush=True)


def delete_sessions(sessions: list[Session], days: int, cutoff: int) -> tuple[int, int]:
    deleted = 0
    failed = 0
    total = len(sessions)
    started = time.perf_counter()
    metrics_path = diagnostics_path()
    try:
        metrics = metrics_path.open("w", encoding="utf-8")
    except OSError as error:
        raise CleanupError(f"could not open the performance log: {error}") from error

    print(f"Performance log: {metrics_path}")
    with metrics:
        record_metric(metrics, "run_started", retention_days=days, candidate_count=total)
        try:
            for position, session in enumerate(sessions, start=1):
                clear_line = "\r\033[2K" if sys.stdout.isatty() else "\r"
                print(
                    f"{clear_line}Processed {position - 1}/{total}; checking {position}/{total}...",
                    end="",
                    flush=True,
                )
                request_started = time.perf_counter()
                try:
                    tree = session_tree(session.id)
                    active = active_session_ids()
                    if any(item.updated >= cutoff or item.id in active for item in tree):
                        record_metric(
                            metrics,
                            "session_skipped_active",
                            session_id=session.id,
                            tree_size=len(tree),
                        )
                        continue
                    delete_session(session.id)
                except CleanupError as error:
                    failed += 1
                    record_metric(
                        metrics,
                        "session_failed",
                        session_id=session.id,
                        error=str(error),
                    )
                    print(f"\nFailed to delete {session.id}: {error}", file=sys.stderr)
                    continue
                deleted += 1
                record_metric(
                    metrics,
                    "session_deleted",
                    session_id=session.id,
                    project_id=session.project_id,
                    directory=session.directory,
                    tree_size=len(tree),
                    duration_ms=round((time.perf_counter() - request_started) * 1_000, 3),
                )
            print(f"{clear_line}Processed {total}/{total} session(s).")
        except KeyboardInterrupt:
            record_metric(
                metrics,
                "run_interrupted",
                deleted=deleted,
                failed=failed,
                elapsed_ms=round((time.perf_counter() - started) * 1_000, 3),
            )
            raise
        except Exception as error:
            record_metric(
                metrics,
                "run_failed",
                deleted=deleted,
                failed=failed,
                error=f"{type(error).__name__}: {error}",
                elapsed_ms=round((time.perf_counter() - started) * 1_000, 3),
            )
            raise
        record_metric(
            metrics,
            "run_completed",
            deleted=deleted,
            failed=failed,
            elapsed_ms=round((time.perf_counter() - started) * 1_000, 3),
        )
    return deleted, failed


def main() -> int:
    args = parse_args()
    cutoff = time.time_ns() // 1_000_000 - args.days * 86_400_000

    try:
        stale_sessions = load_sessions(cutoff)
    except CleanupError as error:
        print(f"Error: {error}", file=sys.stderr)
        return 1

    if not stale_sessions:
        print(f"No sessions have been inactive for more than {args.days} days.")
        return 0

    if not confirm_deletion(stale_sessions, args.days):
        print("No sessions deleted.")
        return 0

    try:
        deleted, failed = delete_sessions(stale_sessions, args.days, cutoff)
    except CleanupError as error:
        print(f"Error: {error}", file=sys.stderr)
        return 1
    print(f"Deleted {deleted} session(s).")
    return 1 if failed else 0


if __name__ == "__main__":
    try:
        status = main()
    except KeyboardInterrupt:
        print("\nStopped. Any completed deletions were preserved.", file=sys.stderr)
        status = 130
    raise SystemExit(status)
