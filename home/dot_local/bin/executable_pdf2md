#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "ocrmypdf",
#     "pymupdf",
# ]
# ///
"""pdf2md - convert PDFs (local files or URLs) to markdown.

Downloads (if URL), optionally OCRs, and converts a PDF to markdown
one physical page at a time, keeping the visual line layout. OCR is
lazy by default: only pages with images and little or broken
extractable text are OCR'd.

Usage:
    pdf2md FILE_OR_URL [OPTIONS]

Options:
    --force-ocr        always run OCR regardless of text detection
    --ocr-inplace      write OCR result back to the source file
                       (local files only)
    --pages SPEC       physical pages to print: 3, 2-4, 1,3, 5-
                       (alias: --page). Without it, output stops at
                       the last whole page within 20000 characters.
    --max-chars-per-page N
                       cut each page to N characters
    --find PATTERN     search output by paragraph (regex or literal)
    -C, --context N    paragraphs of context around --find matches
                       (default: 1)
    --raw              skip post-conversion sanitization
"""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import re
import sys
import tempfile
import unicodedata
import urllib.request
from collections.abc import Iterator
from contextlib import contextmanager
from itertools import pairwise

# A page with images and fewer extractable characters than this is
# considered scanned and gets OCR.
OCR_THRESHOLD = 100
JUNK_TEXT_RATIO = 0.03
MIN_ALNUM_RATIO = 0.5
CACHE_VERSION = 2
# Output budget when --pages is omitted; keeps whole-document dumps
# within a typical LLM tool-output window.
DEFAULT_OUTPUT_CHARS = 20000


def _is_url(source: str) -> bool:
    return source.startswith("http://") or source.startswith("https://")


def _download(url: str, dest: str) -> None:
    req = urllib.request.Request(url, headers={"User-Agent": "pdf2md/1.0"})
    with urllib.request.urlopen(req, timeout=30) as resp:
        with open(dest, "wb") as f:
            while True:
                chunk = resp.read(65536)
                if not chunk:
                    break
                f.write(chunk)


def _cache_root() -> str:
    return os.path.join(
        os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")),
        "pdf2md",
    )


def _cache_path(source: str, *, is_url: bool, force_ocr: bool) -> str:
    if is_url:
        source_identity = source
    else:
        source_path = os.path.abspath(source)
        stat = os.stat(source_path)
        source_identity = f"{source_path}\0{stat.st_size}\0{stat.st_mtime_ns}"

    cache_key = hashlib.sha256(
        f"{CACHE_VERSION}\0{source_identity}\0{force_ocr}".encode()
    ).hexdigest()
    return os.path.join(_cache_root(), f"{cache_key}.json")


def _lock_path(source: str, *, is_url: bool) -> str:
    source_identity = source if is_url else os.path.abspath(source)
    lock_key = hashlib.sha256(f"{is_url}\0{source_identity}".encode()).hexdigest()
    return os.path.join(_cache_root(), f"{lock_key}.lock")


@contextmanager
def _cache_lock(source: str, *, is_url: bool) -> Iterator[None]:
    lock_path = _lock_path(source, is_url=is_url)
    try:
        os.makedirs(os.path.dirname(lock_path), mode=0o700, exist_ok=True)
        lock_fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
    except OSError as error:
        print(f"warning: could not open cache lock: {error}", file=sys.stderr)
        yield
        return

    with os.fdopen(lock_fd, "a+b") as lock_file:
        try:
            fcntl.flock(lock_file, fcntl.LOCK_EX)
        except OSError as error:
            print(f"warning: could not acquire cache lock: {error}", file=sys.stderr)
            yield
            return

        try:
            yield
        finally:
            fcntl.flock(lock_file, fcntl.LOCK_UN)


def _read_cache(path: str) -> list[str] | None:
    """Return cached per-page markdown (index i is physical page i+1)."""
    try:
        with open(path, encoding="utf-8") as cache_file:
            pages = json.load(cache_file)
    except (OSError, ValueError):
        return None
    if not isinstance(pages, list) or not all(isinstance(p, str) for p in pages):
        return None
    return pages


def _write_cache(path: str, pages: list[str]) -> None:
    cache_dir = os.path.dirname(path)
    try:
        os.makedirs(cache_dir, mode=0o700, exist_ok=True)
        fd, temp_path = tempfile.mkstemp(prefix=".pdf2md-", suffix=".json", dir=cache_dir)
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as cache_file:
                json.dump(pages, cache_file)
            os.replace(temp_path, path)
        except Exception:
            try:
                os.unlink(temp_path)
            except OSError:
                pass
            raise
    except OSError as error:
        print(f"warning: could not cache markdown: {error}", file=sys.stderr)


def _is_junk_text(text: str) -> bool:
    """True when a text layer looks like broken font encoding.

    Broken encodings extract either as unmappable glyphs (control,
    private-use, U+FFFD; docling flags >= 3%) or as printable symbol
    soup (marker flags pages where few characters are alphanumeric).
    """
    visible = [c for c in text if not c.isspace()]
    if len(visible) < 20:
        return False
    junk = sum(1 for c in visible if c == "\ufffd" or unicodedata.category(c) in ("Cc", "Co", "Cs"))
    alnum = sum(c.isalnum() for c in visible)
    return junk / len(visible) >= JUNK_TEXT_RATIO or alnum / len(visible) < MIN_ALNUM_RATIO


def _pages_needing_ocr(pdf_path: str) -> list[int]:
    """Return 1-based pages with a broken text layer, or images and little text.

    Decided per page so scanned pages inside mostly digital PDFs still
    get OCR. Low-text pages without images are skipped (OCR cannot add
    text there); broken-text pages are rasterized whatever they contain.
    """
    import pymupdf

    def needs_ocr(page) -> bool:
        # Words, as emitted, not raw text: some PDFs use control
        # characters as word separators, which word splitting absorbs.
        text = " ".join(w[4] for w in page.get_text("words"))
        if _is_junk_text(text):
            return True
        return len(text) < OCR_THRESHOLD and bool(page.get_images())

    with pymupdf.open(pdf_path) as doc:
        return [page.number + 1 for page in doc if needs_ocr(page)]


def _run_ocr(input_path: str, output_path: str, pages: list[int] | None) -> str:
    """Run ocrmypdf on the given pages, or redo OCR on all pages when None.

    Returns the path to the OCR'd PDF.
    """
    import ocrmypdf

    kwargs = {"progress_bar": False}
    if pages is None:
        kwargs["redo_ocr"] = True
    else:
        # Force rasterizes the selected pages, which replaces broken text
        # layers. Unselected pages are not OCR'd, but the output
        # conversion may still alter their text (see _extract_pages).
        kwargs["force_ocr"] = True
        kwargs["pages"] = ",".join(map(str, pages))

    try:
        ocrmypdf.ocr(input_path, output_path, **kwargs)
        return output_path
    except ocrmypdf.PriorOcrFoundError:
        return input_path
    except ocrmypdf.exceptions.ExitCodeException as e:
        print(
            f"warning: ocrmypdf failed ({e}), falling back to original",
            file=sys.stderr,
        )
        return input_path


# ---------------------------------------------------------------------------
# Extraction
#
# Text is rebuilt from word positions so each output line matches one
# visual line. Form PDFs (including flattened DocuSign copies) draw
# values as separate text objects, often after all other content;
# stream-order extractors therefore append them at the page end, run
# together. Position order puts each value on the line where it is
# drawn.
# ---------------------------------------------------------------------------

CHECKBOX_MIN_SIDE = 5.0
CHECKBOX_MAX_SIDE = 12.0
CHECKBOX_TOLERANCE = 1.5
CHECK_MARKS = frozenset("Xx✓✔✗✘")
CHECKBOX_TOKENS = frozenset(("[X]", "[ ]"))
MAX_OPTION_WORDS = 2
# Widest gap, in line heights, between options of one checkbox group.
OPTION_GAP = 4

# A word is (x0, y0, x1, y1, text), in PDF points.
Word = tuple[float, float, float, float, str]


def _close(a: float, b: float) -> bool:
    return abs(a - b) <= CHECKBOX_TOLERANCE


def _is_box_side(length: float) -> bool:
    return CHECKBOX_MIN_SIDE <= length <= CHECKBOX_MAX_SIDE


def _checkbox_squares(page) -> list[tuple[float, float, float, float]]:
    """Find small squares drawn as one rectangle or as four line segments."""
    squares: list[tuple[float, float, float, float]] = []
    horizontal: list[tuple[float, float, float]] = []
    vertical: list[tuple[float, float, float]] = []

    for drawing in page.get_drawings():
        # Dark filled squares are markers (e.g. text-overflow "+"), not boxes.
        fill = drawing.get("fill")
        if fill is not None and min(fill) < 0.5:
            continue
        for item in drawing["items"]:
            if item[0] == "re":
                rect = item[1]
                if _is_box_side(rect.width) and _close(rect.width, rect.height):
                    squares.append((rect.x0, rect.y0, rect.x1, rect.y1))
            elif item[0] == "l":
                start, end = item[1], item[2]
                if _close(start.y, end.y) and _is_box_side(abs(end.x - start.x)):
                    horizontal.append((min(start.x, end.x), max(start.x, end.x), start.y))
                elif _close(start.x, end.x) and _is_box_side(abs(end.y - start.y)):
                    vertical.append((min(start.y, end.y), max(start.y, end.y), start.x))

    for x0, x1, top in horizontal:
        side = x1 - x0
        has_bottom = any(
            _close(bx0, x0) and _close(bx1, x1) and _close(by, top + side)
            for bx0, bx1, by in horizontal
        )
        if not has_bottom:
            continue
        sides = [
            vx
            for vy0, vy1, vx in vertical
            if _close(vy0, top) and _close(vy1, top + side) and (_close(vx, x0) or _close(vx, x1))
        ]
        if any(_close(vx, x0) for vx in sides) and any(_close(vx, x1) for vx in sides):
            squares.append((x0, top, x1, top + side))

    unique: list[tuple[float, float, float, float]] = []
    for square in squares:
        if not any(all(_close(a, b) for a, b in zip(square, kept)) for kept in unique):
            unique.append(square)
    return unique


def _apply_checkboxes(words: list[Word], squares) -> list[Word]:
    """Replace each square and any mark inside it with an [X] or [ ] word."""

    def inside(word: Word, x0: float, y0: float, x1: float, y1: float) -> bool:
        return x0 <= (word[0] + word[2]) / 2 <= x1 and y0 <= (word[1] + word[3]) / 2 <= y1

    remaining = list(words)
    for x0, y0, x1, y1 in squares:
        marks = [w for w in remaining if w[4] in CHECK_MARKS and inside(w, x0, y0, x1, y1)]
        for mark in marks:
            remaining.remove(mark)
        remaining.append((x0, y0, x1, y1, "[X]" if marks else "[ ]"))
    return remaining


def _layout_lines(words: list[Word]) -> str:
    """Group words into visual lines; wide horizontal gaps become ' | '."""
    lines: list[list[Word]] = []
    for word in sorted(words, key=lambda w: ((w[1] + w[3]) / 2, w[0])):
        center = (word[1] + word[3]) / 2
        if lines:
            last = lines[-1]
            top = min(w[1] for w in last)
            bottom = max(w[3] for w in last)
            if top <= center <= bottom:
                last.append(word)
                continue
        lines.append([word])

    out: list[str] = []
    previous_bottom: float | None = None
    for line in lines:
        line.sort(key=lambda w: w[0])
        top = min(w[1] for w in line)
        bottom = max(w[3] for w in line)
        height = max(bottom - top, 1.0)
        if previous_bottom is not None and top - previous_bottom > height:
            out.append("")
        parts = [line[0][4]]
        # Words since the last checkbox. Labeled options of one group stay
        # in one cell ("[ ] YES [X] NO"); unlabeled boxes are columns.
        since_checkbox = 0 if line[0][4] in CHECKBOX_TOKENS else MAX_OPTION_WORDS + 1
        for before, word in pairwise(line):
            is_checkbox = word[4] in CHECKBOX_TOKENS
            gap = word[0] - before[2]
            wide_gap = gap > 2 * height
            same_group = (
                is_checkbox
                and 1 <= since_checkbox <= MAX_OPTION_WORDS
                and gap <= OPTION_GAP * height
            )
            parts.append(" | " if wide_gap and not same_group else " ")
            parts.append(word[4])
            since_checkbox = 0 if is_checkbox else since_checkbox + 1
        out.append("".join(parts))
        previous_bottom = bottom
    return "\n".join(out)


def _form_fields(page) -> str:
    """List live AcroForm values as 'Label: value' lines."""
    import pymupdf

    toggles = (pymupdf.PDF_WIDGET_TYPE_CHECKBOX, pymupdf.PDF_WIDGET_TYPE_RADIOBUTTON)
    lines: list[str] = []
    for widget in page.widgets():
        if widget.field_type == pymupdf.PDF_WIDGET_TYPE_SIGNATURE:
            continue
        label = (widget.field_label or widget.field_name or "").strip()
        value = widget.field_value
        if widget.field_type in toggles:
            checked = value not in (None, False, "", "Off")
            lines.append(f"- {label}: {'[X]' if checked else '[ ]'}")
        elif value not in (None, ""):
            lines.append(f"- {label}: {value}")
    if not lines:
        return ""
    return "Fields:\n" + "\n".join(lines)


def _read_form_fields(pdf_path: str) -> list[str]:
    """Return each page's 'Fields:' block ('' when none).

    Read before OCR runs, because OCR output flattens live form fields.
    """
    import pymupdf

    with pymupdf.open(pdf_path) as doc:
        return [_form_fields(page) for page in doc]


def _extract_pages(
    pdf_path: str,
    fields: list[str],
    ocr_path: str | None = None,
    ocr_pages: list[int] | None = None,
) -> list[str]:
    """Return markdown per physical page (index i is page i+1).

    Pages in ocr_pages (all pages when ocr_pages is None) are read from
    ocr_path. Other pages are read from pdf_path, because ocrmypdf's
    output conversion can alter text on pages it did not OCR.
    """
    import pymupdf

    pages: list[str] = []
    with pymupdf.open(pdf_path) as doc, pymupdf.open(ocr_path or pdf_path) as ocr_doc:
        for page, ocr_page, page_fields in zip(doc, ocr_doc, fields, strict=True):
            if ocr_pages is None or page.number + 1 in ocr_pages:
                page = ocr_page
            words = [w[:5] for w in page.get_text("words")]
            words = _apply_checkboxes(words, _checkbox_squares(page))
            body = _layout_lines(words)
            pages.append(f"{body}\n\n{page_fields}".strip() if page_fields else body)
    return pages


# ---------------------------------------------------------------------------
# Sanitization pipeline
#
# DESIGN: PDF-to-markdown conversion produces artifacts that waste
# tokens when consumed by LLMs: ToC dot leaders, orphan page numbers,
# words broken across lines by column extraction, excessive blank
# lines, etc.  These are inherent to PDF text
# extraction, so we clean them post-conversion, one page at a time.
#
# ARCHITECTURE: Each sanitizer is a pure function (str) -> str.  They
# are collected in the SANITIZERS list and applied in sequence by
# _sanitize().  This pipeline pattern keeps rules isolated, testable,
# and composable.
#
# EXTENSIBILITY: To add a new sanitizer:
#   1. Write a function _remove_foo(text: str) -> str
#   2. Append ("foo", _remove_foo) to SANITIZERS
# That's it.  No registration decorators, no classes, no config.
#
# GUIDELINES FOR NEW SANITIZERS:
#   - Target patterns that are GENERICALLY noisy across many PDFs,
#     not artifacts from a single document.  If a pattern only appears
#     in one file, it does not belong here.
#   - Prefer false-negative (miss some noise) over false-positive
#     (destroy real content).  Use anchoring (^/$), context checks
#     (surrounding blank lines), and length thresholds to stay safe.
#   - Keep each function focused on one pattern.  Compose via
#     ordering rather than coupling sanitizers to each other.
#   - Run _collapse_blank_lines last; earlier sanitizers may leave
#     gaps that it consolidates.
#   - The --raw flag bypasses the entire pipeline for debugging.
# ---------------------------------------------------------------------------


def _remove_dot_leaders(text: str) -> str:
    """Strip ToC-style dot/dash leader lines.

    Matches lines whose non-whitespace content is predominantly
    repeated separator characters (. - _) with optional spacing.
    """
    return re.sub(
        r"^[ \t]*(?:[.\-_][ \t]*){10,}[ \t]*$",
        "",
        text,
        flags=re.MULTILINE,
    )


def _remove_orphan_page_numbers(text: str) -> str:
    """Remove bare page numbers (1-4 digits) on their own line.

    Only matches when the number sits between blank lines so we
    don't accidentally strip meaningful single-number lines inside
    tables or lists.
    """
    return re.sub(
        r"\n\s*\n[ \t]*\d{1,4}[ \t]*\n\s*\n",
        "\n\n",
        text,
    )


def _rejoin_broken_words(text: str) -> str:
    """Rejoin words split across lines by PDF column extraction.

    Targets short lines (<=20 chars) ending mid-word (lowercase
    letter) followed by a line starting with a lowercase letter,
    which strongly indicates a word broken by the PDF renderer.
    """
    return re.sub(
        r"^(.{1,20}[a-z])\n([a-z])",
        r"\1\2",
        text,
        flags=re.MULTILINE,
    )


def _collapse_horizontal_rules(text: str) -> str:
    """Replace excessively long horizontal rules with a standard one."""
    return re.sub(
        r"^[ \t]*[-=]{20,}[ \t]*$",
        "---",
        text,
        flags=re.MULTILINE,
    )


def _collapse_blank_lines(text: str) -> str:
    """Collapse runs of 3+ blank lines down to 2."""
    return re.sub(r"\n{4,}", "\n\n\n", text)


# Sanitizers run in this order.  Append new ones here.
SANITIZERS: list[tuple[str, callable]] = [
    ("dot_leaders", _remove_dot_leaders),
    ("orphan_page_numbers", _remove_orphan_page_numbers),
    ("broken_words", _rejoin_broken_words),
    ("horizontal_rules", _collapse_horizontal_rules),
    ("blank_lines", _collapse_blank_lines),
]


def _sanitize(text: str) -> str:
    """Run all sanitizers in order."""
    for _name, fn in SANITIZERS:
        text = fn(text)
    return text


def _compile_find(pattern: str) -> re.Pattern[str]:
    try:
        return re.compile(pattern, re.IGNORECASE)
    except re.error:
        return re.compile(re.escape(pattern), re.IGNORECASE)


def _paragraph_find(text: str, regex: re.Pattern[str], context: int) -> str:
    """Return matching paragraphs with context, or '' when none match."""
    paragraphs = re.split(r"\n{2,}", text)
    matches = [i for i, para in enumerate(paragraphs) if regex.search(para)]
    if not matches:
        return ""
    seen: set[int] = set()
    result_parts: list[str] = []
    for idx in matches:
        start = max(0, idx - context)
        end = min(len(paragraphs), idx + context + 1)
        for i in range(start, end):
            if i not in seen:
                seen.add(i)
                result_parts.append(paragraphs[i])
        result_parts.append("---")
    return "\n\n".join(result_parts).rstrip("\n-")


def _parse_pages(spec: str, count: int) -> list[int]:
    """Parse '3', '2-4', '1,3', or '5-' into sorted 1-based page numbers.

    Raises ValueError with a user-facing message.
    """
    selected: set[int] = set()
    for item in spec.split(","):
        match = re.fullmatch(r"\s*(\d+)\s*(?:(-)\s*(\d*)\s*)?", item)
        if not match:
            raise ValueError(f"invalid page spec: {spec!r} (use 3, 2-4, 1,3, or 5-)")
        first = int(match.group(1))
        last = first
        if match.group(2):
            last = int(match.group(3)) if match.group(3) else count
        for page in (first, last):
            if page < 1 or page > count:
                raise ValueError(f"page {page} out of range (1-{count} available)")
        if last < first:
            raise ValueError(f"invalid page range: {item.strip()}")
        selected.update(range(first, last + 1))
    return sorted(selected)


def _truncate(text: str, limit: int | None) -> str:
    if limit is None or len(text) <= limit:
        return text
    return text[:limit].rstrip() + "\n[truncated]"


def _render(pages: list[tuple[int, str]]) -> str:
    return "\n\n".join(f"## Page {number}\n\n{body}" for number, body in pages)


def _render_within_budget(pages: list[tuple[int, str]], count: int) -> str:
    """Render whole pages up to DEFAULT_OUTPUT_CHARS, then a continuation hint."""
    shown: list[tuple[int, str]] = []
    for number, body in pages:
        candidate = _render([*shown, (number, body)])
        if shown and len(candidate) > DEFAULT_OUTPUT_CHARS:
            break
        shown.append((number, body))
    if len(shown) == 1 and len(_render(shown)) > DEFAULT_OUTPUT_CHARS:
        number, body = shown[0]
        shown[0] = (number, _truncate(body, DEFAULT_OUTPUT_CHARS))
    output = _render(shown)
    last = shown[-1][0]
    if last < count:
        output += (
            f"\n\n[pages 1-{last} of {count} shown; use --pages {last + 1}- for more,"
            " or --max-chars-per-page N for a preview of each page]"
        )
    return output


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="pdf2md",
        description="Convert a PDF (local file or URL) to markdown.",
    )
    parser.add_argument("source", help="local file path or URL")
    parser.add_argument(
        "--force-ocr",
        action="store_true",
        help="always run OCR regardless of text detection",
    )
    parser.add_argument(
        "--ocr-inplace",
        action="store_true",
        help="write OCR result back to the source file (local only)",
    )
    parser.add_argument(
        "--pages",
        "--page",
        default=None,
        metavar="SPEC",
        help=(
            "physical PDF pages: 3, 2-4, 1,3, or 5- (default: whole pages"
            f" up to {DEFAULT_OUTPUT_CHARS} chars)"
        ),
    )
    parser.add_argument(
        "--max-chars-per-page",
        type=int,
        default=None,
        metavar="N",
        help="cut each page to N characters",
    )
    parser.add_argument(
        "--find",
        default=None,
        help="search output by paragraph (regex or literal)",
    )
    parser.add_argument(
        "-C",
        "--context",
        type=int,
        default=1,
        help="paragraphs of context around --find matches (default: 1)",
    )
    parser.add_argument(
        "--raw",
        action="store_true",
        help="skip post-conversion sanitization",
    )
    opts = parser.parse_args()

    is_url = _is_url(opts.source)

    if opts.ocr_inplace and is_url:
        parser.error("--ocr-inplace cannot be used with URLs")

    if not is_url and not os.path.isfile(opts.source):
        print(f"error: file not found: {opts.source}", file=sys.stderr)
        sys.exit(1)

    cache_path = _cache_path(opts.source, is_url=is_url, force_ocr=opts.force_ocr)
    output = _read_cache(cache_path)

    tmpdir = tempfile.mkdtemp(prefix="pdf2md-")
    tmp_files: list[str] = []

    try:
        if output is None:
            with _cache_lock(opts.source, is_url=is_url):
                cache_path = _cache_path(
                    opts.source,
                    is_url=is_url,
                    force_ocr=opts.force_ocr,
                )
                output = _read_cache(cache_path)

                if output is None:
                    if is_url:
                        pdf_path = os.path.join(tmpdir, "input.pdf")
                        tmp_files.append(pdf_path)
                        try:
                            _download(opts.source, pdf_path)
                        except Exception as e:
                            print(f"error: download failed: {e}", file=sys.stderr)
                            sys.exit(1)
                    else:
                        pdf_path = os.path.abspath(opts.source)

                    fields = _read_form_fields(pdf_path)
                    ocr_pages = None if opts.force_ocr else _pages_needing_ocr(pdf_path)
                    ocr_path = None
                    pages_from_ocr = ocr_pages

                    if ocr_pages is None or ocr_pages:
                        if opts.ocr_inplace:
                            # The original is overwritten; every page reads from OCR output.
                            ocr_out = pdf_path
                            pages_from_ocr = None
                        else:
                            ocr_out = os.path.join(tmpdir, "ocr.pdf")
                            tmp_files.append(ocr_out)

                        ocr_path = _run_ocr(pdf_path, ocr_out, ocr_pages)

                    output = _extract_pages(pdf_path, fields, ocr_path, pages_from_ocr)
                    if opts.ocr_inplace:
                        cache_path = _cache_path(
                            opts.source,
                            is_url=False,
                            force_ocr=opts.force_ocr,
                        )
                    _write_cache(cache_path, output)

        count = len(output)
        if count == 0:
            print("error: PDF has no pages", file=sys.stderr)
            sys.exit(1)
        try:
            numbers = _parse_pages(opts.pages, count) if opts.pages else list(range(1, count + 1))
        except ValueError as error:
            print(f"error: {error}", file=sys.stderr)
            sys.exit(1)

        pages = [(n, output[n - 1] if opts.raw else _sanitize(output[n - 1])) for n in numbers]

        if opts.find:
            regex = _compile_find(opts.find)
            pages = [(n, _paragraph_find(body, regex, opts.context)) for n, body in pages]
            pages = [(n, body) for n, body in pages if body]
            if not pages:
                print(f"No matches for: {opts.find}")
                return

        pages = [(n, _truncate(body, opts.max_chars_per_page)) for n, body in pages]

        if opts.pages or opts.find:
            print(_render(pages))
        else:
            print(_render_within_budget(pages, count))

    finally:
        for f in tmp_files:
            try:
                os.unlink(f)
            except OSError:
                pass
        try:
            os.rmdir(tmpdir)
        except OSError:
            pass


if __name__ == "__main__":
    main()
