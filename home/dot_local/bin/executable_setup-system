#!/usr/bin/env bash
# System setup after chezmoi apply: packages, mise tools, and the login shell.
# Supports macOS (Apple Silicon) and Fedora, both with Homebrew. Idempotent: reruns change nothing
# once set up.

set -euo pipefail

# Terminal colors
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m'

log_info() {
  echo -e "${BLUE}==>${NC} $*"
}

log_success() {
  echo -e "${GREEN}==>${NC} $*"
}

log_error() {
  echo -e "${RED}ERROR:${NC} $*" >&2
}

die() {
  log_error "$*"
  exit 1
}

detect_platform() {
  case "$(uname -s)" in
  Darwin)
    echo "macos"
    ;;
  Linux)
    if [[ -f /etc/fedora-release ]]; then
      echo "fedora"
    else
      die "Unsupported Linux distribution. This script supports Fedora only."
    fi
    ;;
  *)
    die "Unsupported platform. This script supports macOS and Fedora only."
    ;;
  esac
}

install_fedora_packages() {
  log_info "Installing dnf packages..."
  # Desktop packages, the login shell (fixed /usr/bin/zsh), and Homebrew's Linux prerequisites;
  # dnf skips packages that are already installed
  sudo dnf install -y zsh pinentry-qt kitty fira-code-fonts procps-ng curl file git gcc ||
    die "dnf package installation failed"
}

setup_homebrew() {
  local platform="$1" brew
  # The dotfiles (.zshenv, pinentry-serialized) assume these prefixes
  case "$platform" in
  macos) brew=/opt/homebrew/bin/brew ;;
  fedora) brew=/home/linuxbrew/.linuxbrew/bin/brew ;;
  esac

  if [[ ! -x "$brew" ]]; then
    log_info "Installing Homebrew..."
    # Interactive: the installer prompts for sudo to create its prefix directory
    /bin/bash -c \
      "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" ||
      die "Homebrew installation failed"
  fi
  # Puts brew on this process's PATH, so later steps need no new shell or logout
  eval "$("$brew" shellenv bash)"
  log_success "Homebrew: $(brew --version | head -n1)"
}

install_brew_packages() {
  local platform="$1" brewfile
  brewfile=$'brew "mise"\nbrew "rbw"\n'
  if [[ "$platform" == macos ]]; then
    brewfile+=$'brew "zsh"\nbrew "pinentry-mac"\ncask "kitty"\ncask "font-fira-code"\n'
  fi

  log_info "Installing Homebrew packages..."
  # Installs only what is missing; without --no-upgrade, bundle also upgrades outdated packages
  brew bundle --no-upgrade --file=- <<<"$brewfile" || die "Homebrew package installation failed"
}

install_dev_tools() {
  log_info "Installing mise tools..."
  # Installs only missing versions; upgrades and pruning stay manual (topgrade, mise prune)
  mise install || die "mise tool installation failed"
  log_success "mise tools installed"
}

setup_zsh_shell() {
  local platform="$1"

  local zsh_path login_shell
  case "$platform" in
  macos)
    zsh_path=/opt/homebrew/bin/zsh
    # $SHELL stays stale until the next login, so read the account database
    login_shell="$(dscl . -read "/Users/$USER" UserShell | awk '{print $2}')"
    ;;
  fedora)
    zsh_path=/usr/bin/zsh
    login_shell="$(getent passwd "$USER" | cut -d: -f7)"
    ;;
  esac

  [[ -x "$zsh_path" ]] || die "zsh not found at $zsh_path"

  if [[ "$login_shell" == "$zsh_path" ]]; then
    log_success "zsh is already the login shell"
    return 0
  fi

  if ! grep -qx "$zsh_path" /etc/shells; then
    log_info "Adding $zsh_path to /etc/shells (requires sudo)..."
    echo "$zsh_path" | sudo tee -a /etc/shells >/dev/null || die "Failed to update /etc/shells"
  fi

  # No sudo: under sudo, chsh changes root's shell instead of the user's
  log_info "Changing login shell to zsh (asks for your password)..."
  chsh -s "$zsh_path" || die "Failed to change login shell to zsh"
  log_success "Login shell changed to zsh"
}

main() {
  local platform
  platform="$(detect_platform)"
  log_info "Platform: $platform"

  if [[ "$platform" == fedora ]]; then
    install_fedora_packages
  fi
  setup_homebrew "$platform"
  install_brew_packages "$platform"
  install_dev_tools
  setup_zsh_shell "$platform"

  echo ""
  log_success "System setup complete!"
  echo ""
  echo "Next step: log out and back in (or reboot) to start using zsh."
}

main "$@"
