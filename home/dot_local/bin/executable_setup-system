#!/usr/bin/env bash
# System setup after chezmoi apply: packages, mise tools, and the login shell.
# Supports macOS (Apple Silicon Homebrew) and Fedora. Idempotent: reruns change nothing once set up.

set -euo pipefail

# Terminal colors
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m'

log_info() {
  echo -e "${BLUE}==>${NC} $*"
}

log_success() {
  echo -e "${GREEN}==>${NC} $*"
}

log_error() {
  echo -e "${RED}ERROR:${NC} $*" >&2
}

die() {
  log_error "$*"
  exit 1
}

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

detect_platform() {
  case "$(uname -s)" in
  Darwin)
    echo "macos"
    ;;
  Linux)
    if [[ -f /etc/fedora-release ]]; then
      echo "fedora"
    else
      die "Unsupported Linux distribution. This script supports Fedora only."
    fi
    ;;
  *)
    die "Unsupported platform. This script supports macOS and Fedora only."
    ;;
  esac
}

# The dotfiles (fish conf.d, pinentry-serialized) assume this prefix
readonly BREW=/opt/homebrew/bin/brew

setup_homebrew() {
  if [[ ! -x "$BREW" ]]; then
    log_info "Installing Homebrew..."
    # Interactive: the installer needs a sudo password prompt to create /opt/homebrew
    /bin/bash -c \
      "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" ||
      die "Homebrew installation failed"
  fi
  eval "$("$BREW" shellenv bash)"
  log_success "Homebrew: $(brew --version | head -n1)"
}

install_system_packages() {
  local platform="$1"

  log_info "Installing system packages..."
  case "$platform" in
  macos)
    # Installs only what is missing; without --no-upgrade, bundle also upgrades outdated packages
    brew bundle --no-upgrade --file=- <<'EOF' || die "Homebrew package installation failed"
brew "fish"
brew "mise"
brew "rbw"
brew "pinentry-mac"
cask "kitty"
cask "font-fira-code"
EOF
    ;;
  fedora)
    # dnf skips packages that are already installed
    sudo dnf install -y fish rbw pinentry-qt kitty fira-code-fonts ||
      die "dnf package installation failed"
    command_exists mise || curl -fsSL https://mise.run | sh || die "mise installation failed"
    export PATH="$HOME/.local/bin:$PATH"
    ;;
  esac
  log_success "System packages installed"
}

install_dev_tools() {
  log_info "Installing mise tools..."
  # Installs only missing versions; upgrades and pruning stay manual (topgrade, mise prune)
  mise install || die "mise tool installation failed"
  log_success "mise tools installed"
}

setup_fish_shell() {
  local platform="$1"

  local fish_path login_shell
  case "$platform" in
  macos)
    fish_path=/opt/homebrew/bin/fish
    # $SHELL stays stale until the next login, so read the account database
    login_shell="$(dscl . -read "/Users/$USER" UserShell | awk '{print $2}')"
    ;;
  fedora)
    fish_path=/usr/bin/fish
    login_shell="$(getent passwd "$USER" | cut -d: -f7)"
    ;;
  esac

  [[ -x "$fish_path" ]] || die "fish not found at $fish_path"

  if [[ "$login_shell" == "$fish_path" ]]; then
    log_success "fish is already the login shell"
    return 0
  fi

  if ! grep -qx "$fish_path" /etc/shells; then
    log_info "Adding $fish_path to /etc/shells (requires sudo)..."
    echo "$fish_path" | sudo tee -a /etc/shells >/dev/null || die "Failed to update /etc/shells"
  fi

  # No sudo: under sudo, chsh changes root's shell instead of the user's
  log_info "Changing login shell to fish (asks for your password)..."
  chsh -s "$fish_path" || die "Failed to change login shell to fish"
  log_success "Login shell changed to fish"
}

main() {
  local platform
  platform="$(detect_platform)"
  log_info "Platform: $platform"

  if [[ "$platform" == "macos" ]]; then
    setup_homebrew
  fi

  install_system_packages "$platform"
  install_dev_tools
  setup_fish_shell "$platform"

  echo ""
  log_success "System setup complete!"
  echo ""
  echo "Next step: log out and back in (or reboot) to start using fish."
}

main "$@"
