# macOS /etc/zprofile runs path_helper after .zshenv and moves system directories ahead of the
# user and mise shim directories. Re-prepend them; interactive shells get full mise activation in
# .zshrc instead of shims.
if [[ $OSTYPE == darwin* ]]; then
    path=($user_path $path)
    if [[ ! -o interactive ]] && (( $+commands[mise] )); then
        eval "$(mise activate zsh --shims)"
    fi
fi
