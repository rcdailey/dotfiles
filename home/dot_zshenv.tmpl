# XDG Base Directory Specification
# Set before any .zshrc processing; plugin and cache paths derive from them.

export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"
{{- if eq .chezmoi.os "darwin" }}
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-$TMPDIR}"
{{- end }}

# Pinned so a command that overrides XDG_DATA_HOME (e.g. sandboxed tests) keeps mise's installs.
# Without them a shim finds no tool, execs the next same-named binary on PATH (itself), and
# fork-bombs.
export MISE_DATA_DIR="$XDG_DATA_HOME/mise"

# Homebrew prefix path (platform-specific)
{{- if eq .chezmoi.os "darwin" }}
export HOMEBREW_PREFIX="/opt/homebrew"
{{- else if eq .chezmoi.os "linux" }}
export HOMEBREW_PREFIX="/home/linuxbrew/.linuxbrew"
{{- end }}

# Homebrew environment for all shell sessions, including non-login ones.
# Static form of `brew shellenv zsh`, which costs a process per shell; its output depends only on
# the prefix. Re-sync if Homebrew changes what shellenv exports.
if [[ -x "$HOMEBREW_PREFIX/bin/brew" ]]; then
    export HOMEBREW_CELLAR="$HOMEBREW_PREFIX/Cellar"
{{- if eq .chezmoi.os "darwin" }}
    # The macOS installer puts the repository at the prefix itself (install.sh)
    export HOMEBREW_REPOSITORY="$HOMEBREW_PREFIX"
{{- else }}
    export HOMEBREW_REPOSITORY="$HOMEBREW_PREFIX/Homebrew"
{{- end }}
    fpath[1,0]="$HOMEBREW_PREFIX/share/zsh/site-functions"
    export FPATH
    export PATH="$HOMEBREW_PREFIX/bin:$HOMEBREW_PREFIX/sbin${PATH+:$PATH}"
    # Leading MANPATH colon and trailing INFOPATH colon keep the system default dirs searched
    if [[ -n "${MANPATH-}" ]]; then
        export MANPATH="${MANPATH%"${MANPATH##*[!:]}"}"
        export MANPATH=":${MANPATH#"${MANPATH%%[!:]*}"}"
    fi
    export INFOPATH="$HOMEBREW_PREFIX/share/info:${INFOPATH:-}"
fi

# /etc/zprofile and /etc/zshrc source /etc/profile and /etc/profile.d (~30 ms on Fedora). Their
# exported environment is inherited, so only the first shell in a process tree needs them. The
# desktop login shell exports the marker into the session, so terminal shells skip them too and
# lose only shell-local extras (PackageKit command-not-found, magic-space, grep color aliases).
if [[ -n "$__ZSH_GLOBAL_RCS_DONE" ]]; then
    setopt no_global_rcs
else
    export __ZSH_GLOBAL_RCS_DONE=1
fi

# Core shell behavior (needed by all shell types)
export HISTFILE=~/.zsh_history
export HISTSIZE=10000
export SAVEHIST=10000

# Terminal capabilities
export COLORTERM=truecolor

# Editor (needed by scripts/non-interactive contexts)
export EDITOR="code"
export KUBE_EDITOR="code --wait"

# Essential fallback (needed for VS Code/Windows compatibility)
# In some cases TMPDIR is not defined, such as VS Code integrated terminal on Windows
if [[ -z $TMPDIR ]]; then
  export TMPDIR=/tmp
fi

# Timezone for kubectl logs and other tools (POSIX format with DST support)
export TZ="America/Chicago"

# GPG/pinentry TTY ($TTY, not $(tty), which fails during the p10k instant prompt). Without a
# controlling terminal $TTY is empty; keep any inherited value.
[[ -n $TTY ]] && export GPG_TTY=$TTY

# rbw SSH agent
{{- if eq .chezmoi.os "darwin" }}
# The directories crate uses DARWIN_USER_TEMP_DIR, not XDG
export SSH_AUTH_SOCK="$(getconf DARWIN_USER_TEMP_DIR)rbw-$UID/ssh-agent-socket"
{{- else }}
export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/rbw/ssh-agent-socket"
{{- end }}

# Paging
export LESS="-RSic~ -x2"
export DELTA_PAGER="less"
export PSQL_PAGER="pspg"
export LESSHISTSIZE=0
export LESSCHARSET=UTF-8
{{- if eq .chezmoi.os "darwin" }}
export CLICOLOR=1
export LSCOLORS=ExFxBxDxCxegedabagacad
{{- end }}

export DOCKER_UID=$UID DOCKER_GID=$GID
{{- if eq .chezmoi.os "darwin" }}
export DOCKER_DATA_PATH="/Volumes/docker"
{{- else if eq .chezmoi.os "linux" }}
# Supports the migration to k8s in the nezuko repository
export DOCKER_DATA_PATH="/mnt/docker-data"
{{- else if eq .chezmoi.os "windows" }}
export NODE_SKIP_PLATFORM_CHECK=1
{{- end }}

# Disable husky pre-commit hooks (slows down git)
export HUSKY_SKIP_HOOKS=1 # For legacy purposes
export HUSKY=0            # This replaces HUSKY_SKIP_HOOKS

export RIPGREP_CONFIG_PATH="$XDG_CONFIG_HOME/ripgrep/config"

# rumdl defaults to a .rumdl_cache directory in the working directory
export RUMDL_CACHE_DIR="$XDG_CACHE_HOME/rumdl"

# Point Terraform (and other Go net/netrc consumers) at a dedicated netrc file. Siggy (the Statsig
# CLI) hardcodes ~/.netrc and writes non-RFC keywords that break Terraform parsing.
export NETRC="$HOME/.netrc.terraform"

# Homebrew - disable new casks/formula messages and analytics
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_BOOTSNAP=1
export HOMEBREW_NO_ENV_HINTS=1
export HOMEBREW_NO_UPDATE_REPORT_FORMULAE=1
export HOMEBREW_NO_UPDATE_REPORT_CASKS=1
# Casks with auto_updates true (Vivaldi, Docker Desktop) update themselves; --greedy still
# upgrades them on demand
export HOMEBREW_NO_UPGRADE_AUTO_UPDATES_CASKS=1

# Inside herdr, worktrunk's post-switch hook opens the worktree in its own child space, so the
# calling shell stays put (wt switch --cd overrides)
[[ -n "$HERDR_ENV" ]] && export WORKTRUNK_SWITCH__CD=false

# Function autoloading (needed by both interactive and non-interactive shells)
if [[ -d "$XDG_CONFIG_HOME/zsh/functions" ]]; then
  fpath=("$XDG_CONFIG_HOME/zsh/functions" $fpath)
  autoload -Uz $XDG_CONFIG_HOME/zsh/functions/*(:t)
fi

# User executables for all shell types. Non-interactive shells need them too, e.g. `zsh -lc` in
# kitty and herdr-lazygit, and the commands lazygit runs. Listed in priority order; .zprofile
# re-prepends them after macOS path_helper. -U keeps the first entry on re-prepend.
typeset -U path
user_path=(
{{- if eq .chezmoi.os "windows" }}
    # Chocolatey ahead of Git for Windows tools
    "$HOME/AppData/Local/UniGetUI/Chocolatey/bin"
{{- end }}
    "$HOME/.local/kitty.app/bin" # kitty's official installer
    "$HOME/.dotnet/tools"
    # GOPATH defaults to ~/go. Skips `go env GOPATH` (~30 ms), so a GOPATH set only through
    # `go env -w` is not seen.
    "${GOPATH:-$HOME/go}/bin"
    "$HOME/.local/bin"
    "$HOME/bin" # devbox doesn't include it by default
)
path=($user_path $path "$HOME/git-scripts")

# mise shims for shells that skip .zshrc's full setup (non-interactive, or no terminal); full
# activation in 01-environment.sh would strip them again
if [[ ! -o interactive || ! -t 0 ]] && (( $+commands[mise] )); then
    eval "$(mise activate zsh --shims)"
fi
