{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "git commit *": { "action": "deny", "reason": "Use the commit skill and 'commit save'" },
      "git -C * commit *": { "action": "deny", "reason": "Use the commit skill and 'commit save'" },
      "grep *": { "action": "deny", "reason": "Use 'rg' instead of 'grep'" },
      "find -name *": { "action": "deny", "reason": "Use 'rg --files -g glob' instead" },
      "find * -name *": { "action": "deny", "reason": "Use 'rg --files -g glob' instead" },
      "sops --set*": { "action": "deny", "reason": "Use 'sops set'; see 'sops set --help'" },
      "sops * --set*": { "action": "deny", "reason": "Use 'sops set'; see 'sops set --help'" },
      "gh api *": {
        "action": "deny",
        "reason": "'gh api' requires an explicit method: gh api --method GET repos/{owner}/{repo}"
      },
      "gh api *--method*": "ask",
      "gh api *-X*": "ask",
      "gh api *--method GET*": "allow",
      "gh api *--method=GET*": "allow",
      "gh api *-X GET*": "allow",
      "gh api *-XGET*": "allow",

      "git *push *--force*": "ask",
      "git *push *-f": "ask",
      "git *push *-f *": "ask",
      "git *push *+*": "ask",
      "git *reset *--hard*": "ask",
      "git *clean": "ask",
      "git *clean *": "ask",
      "git *stash clear*": "ask",

      "rm -r*": "ask",
      "rm -R*": "ask",
      "rm -fr*": "ask",
      "rm -fR*": "ask",
      "rm --recursive*": "ask",
      "rm * -r*": "ask",
      "rm * -R*": "ask",
      "rm * -fr*": "ask",
      "rm * --recursive*": "ask",
      "rm -* /tmp/*": "allow",
      "sudo *": "ask",
      "pkill *": "ask",
      "killall *": "ask",
      "shutdown *": { "action": "deny", "reason": "Never shut down or reboot the machine" },
      "reboot *": { "action": "deny", "reason": "Never shut down or reboot the machine" },

      "herdr pane swap *": { "action": "deny", "reason": "The user owns herdr layout" },
      "herdr pane move *": { "action": "deny", "reason": "The user owns herdr layout" },
      "herdr pane close *": { "action": "deny", "reason": "The user owns herdr layout" },
      "herdr tab close *": { "action": "deny", "reason": "The user owns herdr layout" },
      "herdr server stop *": "ask",
      "herdr session stop *": "ask",
      "herdr session delete *": "ask",
      "herdr workspace close *": "ask",
      "herdr worktree remove *": "ask",

      "gh pr merge *": "ask",
      "gh pr comment *": "ask",
      "gh pr review *": "ask",
      "gh issue comment *": "ask",
      "gh issue delete *": "ask",
      "gh issue transfer *": "ask",
      "gh release create *": "ask",
      "gh release upload *": "ask",
      "gh release delete *": "ask",
      "gh workflow run *": "ask",
      "gh secret set *": "ask",
      "gh secret delete *": "ask",
      "gh variable set *": "ask",
      "gh variable delete *": "ask",
      "gh label delete *": "ask",
      "gh repo delete *": "ask",
      "gh repo archive *": "ask",
      "gh repo rename *": "ask",
      "gh repo edit *": "ask",
      "gh-review reply *": "ask",
      "gh-review delete *": "ask",

      "* --help": "allow",
      "* --help *": "allow"
    }
  }
}
