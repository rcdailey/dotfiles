#!/usr/bin/env python3

# chezmoi modify_ script: pi also writes settings.json (changelog version, installs, saved
# selections), so merge the managed keys into the live file instead of replacing it.
# Managed keys win on every apply; pi owns all other keys.

import json
import sys

MANAGED = {
    "$schema": "https://pi.dev/schemas/settings.schema.json",
    "defaultProvider": "anthropic",
    "defaultModel": "claude-opus-5-5",
    "defaultThinkingLevel": "medium",
    # Major-only ranges: pi installs the newest matching minor and never crosses a major.
    # 0.x packages pin the minor instead, since semver treats 0.x minors as breaking.
    "packages": [
        "npm:@gotgenes/pi-anthropic-auth@3",
        "npm:@gotgenes/pi-permission-system@41",
        "npm:pi-mcp-adapter@5",
        "npm:pi-web-access@0.42",
        "npm:@gotgenes/pi-subagents@25",
        "npm:@plannotator/pi-extension@0.28",
        "npm:pi-powerline-footer@0.20",
        "npm:pi-lens@4",
        "npm:@ff-labs/pi-fff@0.11",
        "npm:@ian-pascoe/pi-formatter@0.6",
        "npm:pi-context-view@0.7",
        {
            # cursor-* and mercury-* use 8-digit hex (#RRGGBBAA), which pi rejects.
            "source": "npm:@anishthite/pi-themes@0.1",
            "themes": [
                "themes/*.json",
                "!themes/cursor-*.json",
                "!themes/mercury-*.json",
            ],
        },
    ],
    # Read by @ian-pascoe/pi-formatter. A trusted project's .pi/settings.json entry with the
    # same ID replaces the global one; a project disables one with "command": "true".
    "formatter": {
        "formatters": {
            # Runs only where a Prettier config exists, using the project's own install.
            # Markdown is excluded so md-format owns it.
            "prettier": {
                "command": "npx",
                "args": ["--no-install", "prettier", "--write", "$FILE"],
                "files": {
                    "extensions": [
                        ".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx", ".mts", ".cts",
                        ".html", ".htm", ".css", ".scss", ".sass", ".less", ".vue",
                        ".svelte", ".json", ".jsonc", ".yaml", ".yml", ".toml", ".xml",
                        ".graphql", ".gql",
                    ],
                },
                "requireRootMarker": True,
                "rootMarkers": [".prettierrc*", "prettier.config.*"],
            },
            "markdown": {
                "command": "md-format",
                "args": ["$FILE"],
                "files": {"extensions": [".md", ".mdx"]},
            },
            # Matching uses only the last extension, so .md.tmpl arrives as .tmpl; the guard
            # skips other templates (.sh.tmpl, .jsonc.tmpl).
            "markdown-template": {
                "command": "bash",
                "args": [
                    "-c",
                    'case $1 in *.md.tmpl) exec md-format "$1" ;; esac',
                    "_",
                    "$FILE",
                ],
                "files": {"extensions": [".tmpl"]},
            },
        },
    },
    # Read by extensions/compaction-model.ts; summarizes compactions instead of the session model.
    "compactionModel": {"model": "anthropic/claude-haiku-5-5", "thinkingLevel": "low"},
    # Read by pi-powerline-footer; /powerline still owns the preset.
    "powerline": {"disabledSegments": ["cache_read", "cost"]},
    "hideThinkingBlock": True,
    "branchSummary": {"skipPrompt": True},
    "enableInstallTelemetry": False,
}


def merge(current: dict, managed: dict) -> dict:
    for key, value in managed.items():
        if isinstance(value, dict) and isinstance(current.get(key), dict):
            merge(current[key], value)
        else:
            current[key] = value
    return current


raw = sys.stdin.read()
settings = json.loads(raw) if raw.strip() else {}
if not isinstance(settings, dict):
    sys.exit("settings.json must contain a JSON object")

json.dump(merge(settings, MANAGED), sys.stdout, indent=2, ensure_ascii=False)
sys.stdout.write("\n")
