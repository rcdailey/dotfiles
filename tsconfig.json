{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "paths": {
      "@opencode/plugin": ["./tests/opencode/node_modules/@opencode/plugin/dist/promise/index.d.ts"],
      "@opencode/plugin/tui": ["./tests/opencode/node_modules/@opencode/plugin/dist/tui/index.d.ts"],
      "@opentui/core": ["./tests/opencode/node_modules/@opentui/core/index.d.ts"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "typeRoots": ["./tests/opencode/node_modules/@types"],
    "types": ["bun"]
  },
  "include": [
    "home/dot_config/opencode/exact_plugins/**/*.ts",
    "hooks/**/*.mts",
    "tests/opencode/**/*.ts"
  ],
  "exclude": ["**/node_modules/**"]
}
